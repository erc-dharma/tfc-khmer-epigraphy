</lg>
      <lg n="61" met="anuṣṭubh">
<l n="a"><lb n="N59"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>saubhāgyaśr̥ ṅga-saṁjñaś ca</l>
<l n="b"><milestone unit="column" n="b"/>grāmo madhunadī tathā</l>
<l n="c"><lb n="N60"/><milestone unit="column" n="a"/>grāmo vr̥ hatītīrthākhyo</l>
<l n="d"><milestone unit="column" n="b"/>grāmo vakrahalābhidhiḥ</l>
</lg>
      <lg n="62" met="anuṣṭubh">
<l n="a"><lb n="N61"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>grāmo vatasamudrākhyaḥ</l>
<l n="b"><milestone unit="column" n="b"/>samr̥ddhi(p)uram iṣṭakā</l>
<l n="c"><lb n="N62"/><milestone unit="column" n="a"/>Ādhyā Ādhyapure grāmā</l>
<l n="d"><milestone unit="column" n="b"/>dāsī-dāsa-samanvitāḥ</l>
</lg>
      <lg n="63" met="anuṣṭubh">
<l n="a"><lb n="N63"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yathā kathañcil lavdhāś ca</l>
<l n="b"><milestone unit="column" n="b"/>yatra ta[t](ra) vyavasthitāḥ</l>
<l n="c"><lb n="N64"/><milestone unit="column" n="a"/>bhuvaś śrī-madhurendre(ś)=</l>
