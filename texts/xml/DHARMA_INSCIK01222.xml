<l n="b">astaṅgate bhuvi vidheya-vidhau kr̥tārthe</l>
<l n="c"><lb n="N56"/><milestone unit="column" n="a"/>dr̥pta-dviṣat-timiram āśu raṇe sma bhitvā</l>
<l n="d"><milestone unit="column" n="b"/>tasyānujas tribhuvanārka Udeti bhūyaḥ</l>
</lg>
      <lg n="60" met="anuṣṭubh">
