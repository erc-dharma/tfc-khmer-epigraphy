        <body>
                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
<div type="textpart" n="E" xml:lang="san-Latn"><head xml:lang="eng">Eastern Face</head>
  <lg n="1" met="anuṣṭubh">
<l n="a"><lb n="E1"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>śiva-mūrddhābhiṣiktā yā</l>
<l n="b"><milestone unit="column" n="b"/>vāg ekākāśa-gāminī</l>
<l n="c"><lb n="E2"/><milestone unit="column" n="a"/>vaikharyyā(d)i-tr(i)dhā-bhinnā</l>
<l n="d"><milestone unit="column" n="b"/>sā gaṅgeva punātu vaḥ</l>
</lg>
                   <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="E3"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>pārvvatī-pārvvatī-nāthau</l>
<l n="b"><milestone unit="column" n="b"/>saṁpr̥ktau yoni-vījavat</l>
<l n="c"><lb n="E4"/><milestone unit="column" n="a"/>lokārthotpādana-karau</l>
<l n="d"><milestone unit="column" n="b"/>pitarau jagatān name</l>
</lg>
   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="E5"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>namaś śivāya yo ddhyartha</l>
<l n="b"><milestone unit="column" n="b"/>Ekībhūtas sahomayā</l>
<l n="c" enjamb="yes"><lb n="E6"/><milestone unit="column" n="a"/>śiva-śa(vd)aś ś(i)vāśavde</l>
<l n="d"><milestone unit="column" n="b"/>-naika-śeṣīkr̥to yathā</l>
</lg>
   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="E7"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>namas trailokya-gurave</l>
<l n="b"><milestone unit="column" n="b"/>vibhrate śaśi-śekharam</l>
<l n="c"><lb n="E8"/><milestone unit="column" n="a"/>dr̥ṣṭiṁ tīkṣṇa-dyutiṁ gaṅgāṁ</l>
<l n="d"><milestone unit="column" n="b"/>vyaktaṁ vyomātma-mūrttaye
</l>
</lg>
   <lg n="5" met="anuṣṭubh">
<l n="a"><lb n="E9"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>namaś śivāya yo loke</l>
<l n="b"><milestone unit="column" n="b"/>vede ’pi stutigocaraḥ</l>
<l n="c"><lb n="E10"/><milestone unit="column" n="a"/>lokottaratama-jñāne</l>
<l n="d"><milestone unit="column" n="b"/>loke ’pi vyajyate dhvanau</l>
</lg>
   <lg n="6" met="anuṣṭubh">
<l n="a"><lb n="E11"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>hutveva netra-kuṇdāgnau</l>
<l n="b"><milestone unit="column" n="b"/>kāmaṁ kaṇthe sakajjalaḥ</l>
<l n="c" enjamb="yes"><lb n="E12"/><milestone unit="column" n="a"/>yaś candra-kalaśe gaṅgā</l>
<l n="d"><milestone unit="column" n="b"/>-vabhr̥thena punātu vaḥ</l>
</lg>
   <lg n="7" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="E13"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>candra-pravāla-gaṅgāmvu</l>
<l n="b"><milestone unit="column" n="b"/>-sikta-candana-bhūruhaḥ</l>
<l n="c"><lb n="E14"/><milestone unit="column" n="a"/>yasyāhināpi naddhasya</l>
<l n="d"><milestone unit="column" n="b"/>cchāyā loka-trayāśrayaḥ</l>
</lg>
   <lg n="8" met="anuṣṭubh">
<l n="a"><lb n="E15"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yasyome vallabhe gaurī</l>
<l n="b"><milestone unit="column" n="b"/>kīrttiś caikāṁ suvallabhām</l>
<l n="c"><lb n="E16"/><milestone unit="column" n="a"/>dr̥ṣṭvevārddhāṅga-saṅ(ś)liṣṭāṁ</l>
<l n="d"><milestone unit="column" n="b"/>ruṣā sarvva-gatāparā</l>
</lg>
   <lg n="9" met="anuṣṭubh">
<l n="a"><lb n="E17"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>vāma-bhāgo harir yasya</l>
<l n="b"><milestone unit="column" n="b"/>trailokyātulya-vikramaḥ</l>
<l n="c"><lb n="E18"/><milestone unit="column" n="a"/>kā kathā dakṣiṇe bhāge</l>
<l n="d"><milestone unit="column" n="b"/>samudāye ca kā kathā</l>
</lg>
   <lg n="10" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="E19"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yasya kaṇthārppitāhīndra</l>
<l n="b"><milestone unit="column" n="b"/>-viṣa-sparśād ivāsitaḥ</l>
<l n="c" enjamb="yes"><lb n="E20"/><milestone unit="column" n="a"/>kaṇthaś śītāṅśu-gaṅgāmvu</l>
<l n="d"><milestone unit="column" n="b"/>-dhr̥ tir āhlādanāya ca</l>
</lg>
   <lg n="11" met="anuṣṭubh">
<l n="a"><lb n="E21"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>vyavahāra-padātīto</l>
<l n="b"><milestone unit="column" n="b"/>yas sākṣī tu śarīriṇām</l>
<l n="c"><lb n="E22"/><milestone unit="column" n="a"/>māyā-kumbhodare kṣiptvā</l>
<l n="d"><milestone unit="column" n="b"/>mohayaty akhilañ jagat</l>
</lg>
   <lg n="12" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="E23"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yasmiñ candrārka-tārādi</l>
<l n="b"><milestone unit="column" n="b"/>-yonau sphaṭika-bhāsvare</l>
<l n="c"><lb n="E24"/><milestone unit="column" n="a"/>padmarāgādi-ratnānā<milestone unit="column" n="b" break="no"/>ñ</l>
<l n="d">janmaikaṁ sphaṭikaṁ sphuṭam</l>
</lg>
   <lg n="13" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="E25"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>bhūmyambho-vahni-candrārkā</l>
<l n="b"><milestone unit="column" n="b"/>-nila-vyomātma-mūrttayaḥ</l>
<l n="c"><lb n="E26"/><milestone unit="column" n="a"/>sarva-bhūtāśrayo yasya</l>
<l n="d"><milestone unit="column" n="b"/>tadabhaktaḥ kathan nr̥ṇām</l>
</lg>
   <lg n="14" met="anuṣṭubh">
<l n="a"><lb n="E27"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yatpūjāyām adakṣasya</l>
<l n="b"><milestone unit="column" n="b"/>na dakṣasyāpi dakṣatā</l>
<l n="c"><lb n="E28"/><milestone unit="column" n="a"/>virūpākṣābhyanujñāna<milestone unit="column" n="b" break="no"/>m</l>
<l n="d">ato yajñeṣu kalpitam</l>
</lg>
   <lg n="15" met="anuṣṭubh">
<l n="a"><lb n="E29"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yaś śakti-tantubhiḥ protāṁ</l>
<l n="b"><milestone unit="column" n="b"/>varṇa-ratnāvaliṁ vahan</l>
<l n="c"><lb n="E30"/><milestone unit="column" n="a"/>bhūtaye bhūtaye bhūyā<milestone unit="column" n="b" break="no"/>t</l>
<l n="d">sadā vas sa sadāśivaḥ</l>
</lg>
   <lg n="16" met="indravajrā">
<l n="a" enjamb="yes"><lb n="E31"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>Eko 'pi yo deha-bhr̥ tām aneka</l>
<l n="b"><milestone unit="column" n="b"/>-bhedeṣu deheṣu samasta-bhedaḥ</l>
<l n="c" enjamb="yes"><lb n="E32"/><milestone unit="column" n="a"/>dr̥ṣṭo yathendur ghaṭa-koṭi-vāri</l>
<l n="d"><milestone unit="column" n="b"/>-vimvo vidadhyāt sa śivaś śivaṁ vaḥ</l>
</lg>
   <lg n="17" met="anuṣṭubh">
<l n="a"><lb n="E33"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>Anugrahārthaṁ lokānāṁ</l>
<l n="b"><milestone unit="column" n="b"/>bhagavān sa maheśvaraḥ</l>
<l n="c"><lb n="E34"/><milestone unit="column" n="a"/>vabhūva bhuvi vi[pr]endro</l>
<l n="d"><milestone unit="column" n="b"/>mahārāja-gurur guruḥ</l>
</lg>
   <lg n="18" met="anuṣṭubh">
<l n="a"><lb n="E35"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>jñānāmr̥ tañ ca kāvyañ ca</l>
<l n="b"><milestone unit="column" n="b"/>madhuraṁ kr̥tavān iti</l>
<l n="c"><lb n="E36"/><milestone unit="column" n="a"/>madhurendrābhidhāno ’bhū<milestone unit="column" n="b" break="no"/>d</l>
<l n="d">yo bhūri-guṇa-bhūṣitaḥ</l>
</lg>
   <lg n="19" met="anuṣṭubh">
<l n="a"><lb n="E37"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>śavda-rāśi(m a)śeṣaṁ yo</l>
<l n="b"><milestone unit="column" n="b"/>’dhyāpayann aciraṁ guruḥ</l>
<l n="c"><lb n="E38"/><milestone unit="column" n="a"/>śrīsūryyavarmma-devendra<milestone unit="column" n="b" break="no"/>ñ</l>
<l n="d">jahāsevāparaṁ gurum</l>
</lg>
   <lg n="20" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="E39"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>guhyādi-ṭīkā-kārī śrī</l>
<l n="b"><milestone unit="column" n="b"/>-bhūpendra-kavi-puṅgavaḥ</l>
<l n="c" enjamb="yes"><lb n="E40"/><milestone unit="column" n="a"/>śrī-niśākarasūriśśrī</l>
<l n="d"><milestone unit="column" n="b"/>-sūryyasūrī yatīśvarau</l>
</lg>
   <lg n="21" met="anuṣṭubh">
<l n="a"><lb n="E41"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>śrī-kavīndrakavir vidvān</l>
<l n="b"><milestone unit="column" n="b"/>śrī-vāgīśānapaṇḍitaḥ</l>
<l n="c"><lb n="E42"/><milestone unit="column" n="a"/>vipra-kṣatrās suvahavo</l>
<l n="d"><milestone unit="column" n="b"/>vahavo vivudharṣabhāḥ</l>
</lg>
   <lg n="22" met="anuṣṭubh">
<l n="a"><lb n="E43"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>paśu-pāśāpanodārthaṁ</l>
<l n="b"><milestone unit="column" n="b"/>bhuvi jātasya śūlinaḥ</l>
<l n="c" enjamb="yes"><lb n="E44"/><milestone unit="column" n="a"/>yasyaite ’nuśatāś śiṣya</l>
<l n="d"><milestone unit="column" n="b"/>-gaṇā rudra-gaṇā Iva</l>
</lg>
   <lg n="23" met="anuṣṭubh">
<l n="a"><lb n="E45"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>bhūyaḥ kāle tu saṁprāpte</l>
<l n="b"><milestone unit="column" n="b"/>pāvanārthaṁ śarīriṇām</l>
<l n="c"><lb n="E46"/><milestone unit="column" n="a"/>nīpahrada-nadī-tīre</l>
<l n="d"><milestone unit="column" n="b"/>liṅga-bhūtas sa tais saha</l>
</lg>
   <lg n="24" met="anuṣṭubh">
<l n="a"><lb n="E47"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>pūrvva-nāmāṅkitan nāma</l>
<l n="b"><milestone unit="column" n="b"/>vibhrāṇaś śiṣya-sattamaiḥ</l>
<l n="c" enjamb="yes"><lb n="E48"/><milestone unit="column" n="a"/>pūrvva-nāmāṅkitaiś cāsī<milestone unit="column" n="b" break="no"/>t</l>
<l n="d">tair vr̥ tas sa yathā purā</l>
</lg>
   <lg n="25" met="mālinī">
<l n="a"><lb n="E49"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>satata-vitata-bhāsvat-svarddhir arddhendu-mauli<milestone unit="column" n="b" break="no"/>r</l>
<l n="b">nr̥pa-guru-guru-mūrttir liṅga-mūrttis sa bhūyaḥ</l>
<l n="c"><lb n="E50"/><milestone unit="column" n="a"/>vahu-havir iha bhoktuṁ havya-vāha-sthito ’pi</l>
<l n="d"><milestone unit="column" n="b"/>sphuṭam atanuta tatra svan tryavasthā-viśeṣam</l>
</lg>
   <lg n="26" met="anuṣṭubh">
<l n="a"><lb n="E51"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>caturthamarupāde ca</l>
<l n="b"><milestone unit="column" n="b"/>sthitaṁ caṁnattrasyak puram</l>
<l n="c"><lb n="E52"/><milestone unit="column" n="a"/>vadvidyāvīraviṣaye</l>
<l n="d"><milestone unit="column" n="b"/>raktavarṇnaḥ kralātapaḥ</l>
</lg>
   <lg n="27" met="anuṣṭubh">
<l n="a"><lb n="E53"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>viṣaye vrāhmaṇahr̥to</l>
<l n="b"><milestone unit="column" n="b"/>viṣṇor bhadrālayas sthitaḥ</l>
<l n="c"><lb n="E54"/><milestone unit="column" n="a"/>magnavaṅśābhidhir grāma<milestone unit="column" n="b" break="no"/>s</l>
<l n="d">sādhyāyāṁ viṣaye sthitaḥ</l>
</lg>
   <lg n="28" met="anuṣṭubh">
<l n="a"><lb n="E55"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>harigrāmābhidhir grāmo</l>
<l n="b"><milestone unit="column" n="b"/>vraivanhāṁgrāma ity ubhau</l>
<l n="c"><lb n="E56"/><milestone unit="column" n="a"/>grāmau thpal phcik pradeśasthau</l>
<l n="d"><milestone unit="column" n="b"/>stuk kaṁhe-saṁjñakaṁ puram</l>
</lg>
   <lg n="29" met="anuṣṭubh">
<l n="a"><lb n="E57"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>śivapādasya viṣaye</l>
<l n="b"><milestone unit="column" n="b"/>dattābhis saha bhūmibhiḥ</l>
<l n="c"><lb n="E58"/><milestone unit="column" n="a"/>jimagrāmo maṅmāṅ grāma<milestone unit="column" n="b" break="no"/>s</l>
<l n="d">tāvañcen-viṣaye sthitau</l>
</lg>
   <lg n="30" met="anuṣṭubh">
<l n="a"><lb n="E59"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>Ādhyā vicitra-saṁjñā ca</l>
<l n="b"><milestone unit="column" n="b"/>bhūmir bhīmapure sth[i]tā</l>
<l n="c"><lb n="E60"/><milestone unit="column" n="a"/>ṣaddakṣare ’moghapure</l>
<l n="d"><milestone unit="column" n="b"/>canlattai-saṁjñakaṁ puram</l>
</lg>
   <lg n="31" met="anuṣṭubh">
<l n="a"><lb n="E61"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>dvijendrapurapallī ca</l>
<l n="b"><milestone unit="column" n="b"/>stuk{a} chlyaṅ bhū vnurkuṭī tathā</l>
<l n="c"><lb n="E62"/><milestone unit="column" n="a"/>haṅrkā kaṁvaṅ danlā go kvā<milestone unit="column" n="b" break="no"/>r</l>
<l n="d">tapovanapuran tathā</l>
</lg>
   <lg n="32" met="anuṣṭubh">
<l n="a"><lb n="E63"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>sūryyagrāmas saridbhaṅgo</l>
<l n="b"><milestone unit="column" n="b"/>vraidadiṅ dnaṅpuran tathā</l>
<l n="c"><lb n="E64"/><milestone unit="column" n="a"/>tryamvake viṣaye grāmāḥ</l>
<l n="d"><milestone unit="column" n="b"/>dasī-dāsa-samanvitāḥ</l>
</lg>
</div>
   <div type="textpart" n="N" xml:lang="san-Latn"><head xml:lang="eng">Northern Face</head>
  <lg n="33" met="upendravajrā">
<l n="a"><lb n="N1"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>Āsī(j) [ja](y)ī śrī-jayavarmma-devo</l>
<l n="b"><milestone unit="column" n="b"/>mahāmahīndrānvaya[j]o mahīndraḥ</l>
<l n="c"><lb n="N2"/><milestone unit="column" n="a"/>(Ā vāridher ānata-rāja-rāji)<milestone unit="column" n="b" break="no"/>r</l>
<l n="d">e(t)asya (ca)ndrasya (ca) rāja-śabdaḥ</l>
</lg>
                   <lg n="34" met="upendravajrā">
<l n="a"><lb n="N3"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>(rakṣā-nayādhāna)-dhanā(di)-dānaiḥ</l>
<l n="b"><milestone unit="column" n="b"/>prajāḥ (prajāvat p)aripālayan yaḥ</l>
<l n="c"><lb n="N4"/><milestone unit="column" n="a"/>pitā prajānāṁ sa pitā tu tāsāṁ</l>
<l n="d"><milestone unit="column" n="b"/>kuntyāṁ (yathendro ’janayat) su(taṁ) prāk</l>
</lg>
      <lg n="35" met="upendravajrā">
