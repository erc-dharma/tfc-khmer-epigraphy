</lg>
                   <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="2"/><milestone unit="column" n="a"/>====-++=</l>
<l n="b"><milestone unit="column" n="b"/>====-++śrīḥ</l>
<l n="c"><milestone unit="column" n="c"/>====-++=</l>
<l n="d"><milestone unit="column" n="d"/>===śriyan diśatu <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="3"/><milestone unit="column" n="a"/>====-++=</l>
<l n="b"><milestone unit="column" n="b"/>====-+-=</l>
<l n="c"><milestone unit="column" n="c"/>= = = śrīndravarmmeti</l>
<l n="d"><milestone unit="column" n="d"/>mahendropendravikramaḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="4"/><milestone unit="column" n="a"/>====-++=</l>
<l n="b"><milestone unit="column" n="b"/>====-+-=</l>
<l n="c"><milestone unit="column" n="c"/>====-++=</l>
<l n="d"><milestone unit="column" n="d"/>==ni=-+-= [<g ref="sym:doubleBar-ornate" type="punctuation">.</g>]</l>
</lg>
                   <lg n="5" met="anuṣṭubh">
<l n="a"><lb n="5"/><milestone unit="column" n="a"/>====-+tena</l>
<l n="b"><milestone unit="column" n="b"/>====-+-=</l>
<l n="c"><milestone unit="column" n="c"/>= = = = śriyaṁ prāpya</l>
<l n="d"><milestone unit="column" n="d"/>====-+-= [<g ref="sym:doubleBar-ornate" type="punctuation">.</g>]</l>
</lg>
                   <lg n="6" met="anuṣṭubh">
<l n="a"><lb n="6"/><milestone unit="column" n="a"/>vaṣpārdritāni padmāni</l>
<l n="b"><milestone unit="column" n="b"/>va = ṣara-+-=</l>
<l n="c"><milestone unit="column" n="c"/>vaktrāni sūcayanty evaṁ</l>
<l n="d"><milestone unit="column" n="d"/>yasya yāmavidhiṁ prati <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="anuṣṭubh">
<l n="a"><lb n="7"/><milestone unit="column" n="a"/>yo viṣtapasadas satya</l>
<l n="b"><milestone unit="column" n="b"/>saṁpat sakā-+-=</l>
<l n="c"><milestone unit="column" n="c"/>====-++=</l>
<l n="d"><milestone unit="column" n="d"/>kīrttisatram akalpayat <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="8" met="anuṣṭubh">
<l n="a"><lb n="8"/><milestone unit="column" n="a"/>calāpi lakṣmīs tiṣṭhantī</l>
<l n="b"><milestone unit="column" n="b"/>yasmin yogye ca +-=</l>
<l n="c"><milestone unit="column" n="c"/>====-++=</l>
<l n="d"><milestone unit="column" n="d"/>=ryyānukaraṇād iva <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="9" met="anuṣṭubh">
<l n="a"><lb n="9i"/><milestone unit="column" n="a"/>purā prajāpatiṁ sraṣṭuṁ</l>
<l n="b"><milestone unit="column" n="b"/>taptaṁ yad vrahmaṇā tapaḥ</l>
<l n="c"><milestone unit="column" n="c"/>====-++=</l>
<l n="d"><milestone unit="column" n="d"/>yas tat talam ivābhavat <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="10" met="anuṣṭubh">
<l n="a"><lb n="10"/><milestone unit="column" n="a"/>ṣadarīn durjjayān ādyā</l>
<l n="b"><milestone unit="column" n="b"/>tv ākalimahārathā</l><!-- kuch: GC: Sic. Il manque une syllabe. -->
<l n="c"><milestone unit="column" n="c"/>====-++=</l>
<l n="d"><milestone unit="column" n="d"/>=bhuvaṁ bubhuje malām<g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="11" met="anuṣṭubh">
<l n="a"><lb n="11"/><milestone unit="column" n="a"/>śārṅgajyāghātajanit<choice><unclear>a</unclear><unclear>u</unclear></choice><milestone unit="column" n="b" break="no"/>ṅ</l>
<l n="b">kagahanāvr̥te -=</l>
<l n="c"><milestone unit="column" n="c"/>= = ndum bhudhareṇāpi</l>
<l n="d"><milestone unit="column" n="d"/>sandadhe sādhvase 'pi yaḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
