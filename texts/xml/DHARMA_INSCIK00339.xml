<l n="c" enjamb="yes"><lb n="S6"/><milestone unit="column" n="a"/>namrāmaraśiroratna</l>
<l n="d"><milestone unit="column" n="b"/>-raśmirājivirājitā <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="vasantatilakā">
<l n="a" enjamb="yes"><lb n="S7"/><milestone unit="column" n="a"/>Āsīt samudracaturarddhadharādharāpta</l>
<l n="b"><milestone unit="column" n="b"/>rājyodayo 'bhyudayado namatān nr̥pendraḥ</l>
<l n="c"><lb n="S8"/><milestone unit="column" n="a"/>śrīmān vijr̥mbhitanayo jayavarmmadevo</l>
<l n="d"><milestone unit="column" n="b"/>devādhipendra Iva goptum ilāṅ gato yaḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="anuṣṭubh">
