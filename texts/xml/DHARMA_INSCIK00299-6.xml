<p>
   <lb n="1"/><g ref="sym:circle-bullseye" type="punctuation">.</g>kriminicaya <g ref="sym:spiral" type="punctuation">.</g> qnak· ta nindā devatā <g ref="sym:spiral" type="punctuation">.</g> vraḥ vleṅ· <g ref="sym:spiral" type="punctuation">.</g> guru <g ref="sym:spiral" type="punctuation">.</g> vrāhmaṇa <g ref="sym:spiral" type="punctuation">.</g> mahājñāna<g ref="sym:spiral" type="punctuation">.</g> qnak· ta pra<unclear>d</unclear>au dharmma <g ref="sym:spiral" type="punctuation">.</g> qnak· ta śivabhakti <g ref="sym:spiral" type="punctuation">.</g> qme <g ref="sym:spiral" type="punctuation">.</g> vapā <g ref="sym:spiral" type="punctuation">.</g> suhr̥t· <g ref="sym:gomutra" type="punctuation">.</g>
