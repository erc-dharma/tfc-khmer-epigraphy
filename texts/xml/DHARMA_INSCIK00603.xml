                <div type="edition" xml:lang="okz-Latn" rendition="class:83231 maturity:83213">
<div type="textpart" n="A" xml:lang="san-Latn"><head xml:lang="eng">Fragment</head>
<lg n="1" met="anuṣṭubh">
<l n="a"><lb n="A1"/><milestone unit="column" n="a"/>… rendravijaya …</l>
<l n="b"><milestone unit="column" n="b"/>====-+-=</l>
<l n="c"><lb n="A2"/><milestone unit="column" n="a"/> śrījayendrāyudhākhyāñ ca</l>
<l n="d"><milestone unit="column" n="b"/>pu = = = -+-=</l>
</lg>
   <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="A3"/><milestone unit="column" n="a"/>[śa]ktyobhayos tayor eva</l>
<l n="b"><milestone unit="column" n="b"/>bhattaru = -+-=</l>
<l n="c"><lb n="A4"/><milestone unit="column" n="a"/>yāny atrāpy acirābhābhāṁ</l>
<l n="d"><milestone unit="column" n="b"/>lakṣmī[ṁ] lebhe gabhīra = <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="A5"/><milestone unit="column" n="a"/>śrīsarvvā cī -++=</l>
<l n="b"><milestone unit="column" n="b"/>sahr̥dāsthāpayad kr̥tī</l>
<l n="c"><lb n="A6"/><milestone unit="column" n="a"/>bhagavantam imaṁ viṣṇuṁ</l>
<l n="d"><milestone unit="column" n="b"/>mr̥te tasminn apālayat <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="A7"/><milestone unit="column" n="a"/>R̥gdattam astaiyāt kṣa =</l>
<l n="b"><milestone unit="column" n="b"/>= = = = - kair bhr̥tam</l>
<l n="c"><lb n="A8"/><milestone unit="column" n="a"/>nirjjitya tān apasa =</l>
<l n="d"><milestone unit="column" n="b"/>====-+-= <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
</div>
                   <div type="textpart" n="B" xml:lang="okz-Latn"><head xml:lang="eng">Fragment</head>
                   <p>
   <lb n="B1"/>… k {1} tarāp bhūmy …
   <lb n="B2"/>… [da]kṣiṇa Iss hluṁ paścima Iss …
   <lb n="B3"/>… ra
</p> 
