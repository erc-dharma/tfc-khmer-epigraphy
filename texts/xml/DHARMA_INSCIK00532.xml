   <text xml:space="preserve">
        <body>
                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
<lg n="1" met="anuṣṭubh"><milestone type="pagelike" unit="face" n="1"/><label xml:lang="eng">Southern doorjamb</label>
<l n="a" enjamb="yes"><lb n="S1"/><milestone n="a" unit="column"/>namaś śivāya yatpāda</l>
<l n="b"><milestone n="b" unit="column"/>-kuśeśayarajo rajaḥ</l>
<l n="c" enjamb="yes"><lb n="S2"/><milestone n="a" unit="column"/>tridaśatridaśārīndra</l>
<l n="d"><milestone n="b" unit="column"/>-śiromaṇdāramaṇdiram <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="S3"/><milestone n="a" unit="column"/>jejīyate mvujākṣeṇa</l>
<l n="b"><milestone n="b" unit="column"/>yasya tejo tidurjjayam</l>
<l n="c" enjamb="yes"><lb n="S4"/><milestone n="a" unit="column"/>daityadarppendhanoddāha</l>
<l n="d"><milestone n="b" unit="column"/>-dhūtadhūmadhvajāyate <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="S5"/><milestone n="a" unit="column"/>[tā]mrapādanakhāgrāni</l>
<l n="b"><milestone n="b" unit="column"/>pāntu vaḥ padmajanmanaḥ</l>
<l n="c"><lb n="S6"/><milestone n="a" unit="column"/>nirastāśeṣarāgasya</l>
<l n="d"><milestone n="b" unit="column"/>vartmānīva hr̥dālayāt <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="S7"/><milestone n="a" unit="column"/>namāmy umāṁ mukhaṁ yasyā<milestone n="b" unit="column" break="no"/>s</l>
<l n="b">smitam īśasya darśane</l>
<l n="c" enjamb="yes"><lb n="S8"/><milestone n="a" unit="column"/>pūrṇṇacandrāyate candra</l>
<l n="d"><milestone n="b" unit="column"/>-khaṇdaṁ mūrddhnīva ninditum <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="anuṣṭubh">
<l n="a"><lb n="S9"/><milestone n="a" unit="column"/>sarvatra vyāpinīṁ vande</l>
<l n="b"><milestone n="b" unit="column"/>bhāratīṁ bhūribhāratīm</l>
<l n="c" enjamb="yes"><lb n="S10"/><milestone n="a" unit="column"/>[su]dhāvadanapūrṇṇendu</l>
<l n="d"><milestone n="b" unit="column"/>-kalāṁ pīyūṣavarṣiṇīm <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="6" met="anuṣṭubh">
<l n="a"><lb n="S11"/><milestone n="a" unit="column"/>vande śrī-śivaliṅgākhyaṁ</l>
<l n="b"><milestone n="b" unit="column"/>śaṅkaraṁ viśvaśaṅkaram</l>
<l n="c"><lb n="S12"/><milestone n="a" unit="column"/>Aṇimādiguṇānindya<milestone n="b" unit="column" break="no"/>m</l>
<l n="d">aninditapurāsapadam <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="anuṣṭubh">
<l n="a"><lb n="S13"/><milestone n="a" unit="column"/>babhūva bhūbhr̥tāṁ bharttā</l>
<l n="b"><milestone n="b" unit="column"/>śrīndravarmmāridurjjayaḥ</l>
<l n="c"><lb n="S14"/><milestone n="a" unit="column"/>śrīkamvujendra++=</l>
<l n="d"><milestone n="b" unit="column"/>====-+-= <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="8" met="anuṣṭubh">
<l n="a"><lb n="S15"/><milestone n="a" unit="column"/>nirjjitāceṣate[jasā]</l>
<l n="b"><milestone n="b" unit="column"/>me [k]v[ā]gniḥ kevalo drutaḥ</l>
<l n="c"><lb n="S16"/><milestone n="a" unit="column"/>[vi]līna Iti yattejo</l>
<l n="d"><milestone n="b" unit="column"/>diśo gān mārggaṇād iva <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="9" met="anuṣṭubh">
<l n="a"><lb n="S17"/><milestone n="a" unit="column"/>[dhāu]tair iva yaśoratnai<milestone n="b" unit="column" break="no"/>s</l>
<l n="b">sadā dānāmvudhārayā</l>
<l n="c"><lb n="S18"/><milestone n="a" unit="column"/>[vi]śuddhair yasya hāriṇyo</l>
<l n="d"><milestone n="b" unit="column"/>bhavanty adyāpi dikstriyaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="10" met="anuṣṭubh">
<l n="a"><lb n="S19"/><milestone n="a" unit="column"/>kutra kāntir anaṅgasya</l>
<l n="b"><milestone n="b" unit="column"/>dagdhasyeyaṁ bhaved iti</l>
<l n="c"><lb n="S20"/><milestone n="a" unit="column"/>tatsthirāśritaye dhātrā</l>
<l n="d"><milestone n="b" unit="column"/>durddharṣo yo nunirmmame <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="11" met="anuṣṭubh">
<l n="a"><lb n="S21"/><milestone n="a" unit="column"/>[bhi]nnebhakumbhato yena</l>
<l n="b"><milestone n="b" unit="column"/>muktā sāsr̥gvisāritā[ḥ]</l>
<l n="c"><lb n="S22"/><milestone n="a" unit="column"/>[sara]ktacandanajalā</l>
<l n="d"><milestone n="b" unit="column"/>puṣpavr̥ṣtir ivāhave <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="12" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="S23"/><milestone n="a" unit="column"/>tasya putro jagadgīta</l>
<l n="b"><milestone n="b" unit="column"/>-guṇo rājā dharābhujām</l>
<l n="c"><lb n="S24"/><milestone n="a" unit="column"/>śrīyaśovarmmanāmābhū<milestone n="b" unit="column" break="no"/>d</l>
<l n="d">aridviradakesarī <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="13" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="S25"/><milestone n="a" unit="column"/>==lavāle yatte[jo]</l>
<l n="b"><milestone n="b" unit="column"/>-naladagdhadviḍindhane</l>
<l n="c"><lb n="S26"/><milestone n="a" unit="column"/>==yaśodrumo rūḍha<milestone n="b" unit="column" break="no"/>ś</l>
<l n="d">chādayaty akhilañ jagat <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="14" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="S27"/><milestone n="a" unit="column"/>==nayuddhānale śastra</l>
<l n="b"><milestone n="b" unit="column"/>-dhūme sr̥ksarppirujjvale</l>
<l n="c"><lb n="S28"/><milestone n="a" unit="column"/>==ripuyaśohavyaṁ</l>
<l n="d"><milestone n="b" unit="column"/>sthāpitās svayaśomarāḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="15" met="anuṣṭubh">
<l n="a"><lb n="S29"/><milestone n="a" unit="column"/>[yad]arībhendrakumbhebhyo</l>
<l n="b"><milestone n="b" unit="column"/>muktaṁ mauktikam āhave</l>
<l n="c"><lb n="S30"/><milestone n="a" unit="column"/>[di]gdigdrutāyā yatkīrtte<milestone n="b" unit="column" break="no"/>r</l>
<l n="d">hārajālam ivāgalat <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="16" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="S31"/><milestone n="a" unit="column"/>[kā]māṅgapratimasvāṅga</l>
<l n="b"><milestone n="b" unit="column"/>-dahanāśaṅkayeva yaḥ</l>
<l n="c"><lb n="S32"/><milestone n="a" unit="column"/>=drasahajasauhārddaṁ</l>
<l n="d"><milestone n="b" unit="column"/>sudhāvdhau hr̥daye vyadhāt <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="17" met="anuṣṭubh">
<l n="a"><lb n="S33"/><milestone n="a" unit="column"/>tasya sūnur anūnaśrī<milestone n="b" unit="column" break="no"/>ś</l>
<l n="b">śrītrivikramavikramaḥ</l>
<l n="c"><lb n="S34"/><milestone n="a" unit="column"/>[śrī]harṣavarmmanāmāsī<milestone n="b" unit="column" break="no"/>d</l>
<l n="d">adhīśo śeṣabhūbhujām <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="18" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="S35"/><milestone n="a" unit="column"/>==damīśvaraśiro</l>
<l n="b"><milestone n="b" unit="column"/>-viśadopāśraya[ṁ] yaśaḥ</l>
<l n="c"><lb n="S36"/><milestone n="a" unit="column"/>===tajagad yasya</l>
<l n="d"><milestone n="b" unit="column"/>gaṅgāvārīva rājate <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="19" met="anuṣṭubh">
<l n="a"><lb n="S37"/><milestone n="a" unit="column"/>===hlādīni vibhra<milestone n="b" unit="column" break="no"/>d</l>
<l n="b">āsamudralasattaraḥ</l>
<l n="c"><lb n="S38"/><milestone n="a" unit="column"/>śiṣṭakalāḍhyo ya<milestone n="b" unit="column" break="no"/>s</l>
<l n="d">tuhināṅśur ivāparaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="20" met="anuṣṭubh">
<l n="a"><lb n="S39"/><milestone n="a" unit="column"/>====-+indra<milestone n="b" unit="column" break="no"/>ś</l>
<l n="b">śrīdharaḥ padmalocanaḥ</l>
<l n="c"><lb n="S40"/><milestone n="a" unit="column"/>====-++=</l>
<l n="d"><milestone n="b" unit="column"/>===hur ivāparaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="21" met="anuṣṭubh">
<l n="a"><lb n="S41"/><milestone n="a" unit="column"/>====-++=</l>
<l n="b"><milestone n="b" unit="column"/>====-+-=</l>
<l n="c"><lb n="S42"/><milestone n="a" unit="column"/>====-++=</l>
<l n="d"><milestone n="b" unit="column"/>====-+-= <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="22" met="anuṣṭubh"><milestone type="pagelike" unit="face" n="2"/><label xml:lang="eng">Northern doorjamb</label>
<l n="a"><lb n="N1"/><milestone n="a" unit="column"/>====-++=</l>
<l n="b"><milestone n="b" unit="column"/>====-+-=</l>
<l n="c"><lb n="N2"/><milestone n="a" unit="column"/>====-++=</l>
<l n="d"><milestone n="b" unit="column"/>====-+-= <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="23" met="anuṣṭubh">
<l n="a"><lb n="N3"/><milestone n="a" unit="column"/>====-++bhya<milestone n="b" unit="column" break="no"/>s</l>
<l n="b">tebhya[s]==-+-=</l>
<l n="c"><lb n="N4"/><milestone n="a" unit="column"/>====-++=</l>
<l n="d"><milestone n="b" unit="column"/>=n māninam avā[pa] yaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="24" met="anuṣṭubh">
<l n="a"><lb n="N5"/><milestone n="a" unit="column"/>====-++=</l>
<l n="b"><milestone n="b" unit="column"/>=dridvyaṅśe mū[l]odaye</l>
<l n="c"><lb n="N6"/><milestone n="a" unit="column"/>==ka=-++=</l>
<l n="d"><milestone n="b" unit="column"/>talākṣighaṭaśo ṅgaṇā <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="25" met="anuṣṭubh">
<l n="a"><lb n="N7"/><milestone n="a" unit="column"/>[śu]ddhayaśodharapure</l>
<l n="b"><milestone n="b" unit="column"/>sthāpayit[v]edam aiśvaraṁ</l>
<l n="c"><lb n="N8"/><milestone n="a" unit="column"/>[sa] śrībhadrāśrame bhūyo</l>
<l n="d"><milestone n="b" unit="column"/>liṅgam anyad atiṣṭhipat <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="26" met="anuṣṭubh">
<l n="a"><lb n="N9"/><milestone n="a" unit="column"/>[bha]drāvāse sa liṅge dve</l>
<l n="b"><milestone n="b" unit="column"/>bhāratīpratimām api</l>
<l n="c"><lb n="N10"/><milestone n="a" unit="column"/>śivaparvvataśr̥ṅge pi</l>
<l n="d"><milestone n="b" unit="column"/>liṅgatrayam atiṣṭhipat <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="27" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="N11"/><milestone n="a" unit="column"/>liṅgaṁ bhīmapure mogha</l>
<l n="b"><milestone n="b" unit="column"/>-pure liṅge ca sa vyadhāt</l>
<l n="c"><lb n="N12"/><milestone n="a" unit="column"/>liṅgaikāṅśau sabhīmārccā<milestone n="b" unit="column" break="no"/>v</l>
<l n="d">aninditapure punaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="28" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="N13"/><milestone n="a" unit="column"/>==liṅgapure śambhu</l>
<l n="b"><milestone n="b" unit="column"/>-pure śivapure pure</l>
<l n="c"><lb n="N14"/><milestone n="a" unit="column"/>vakakākeśvarapure</l>
<l n="d"><milestone n="b" unit="column"/>vidadhe śrīmadāśramān <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="29" met="anuṣṭubh">
<l n="a"><lb n="N15"/><milestone n="a" unit="column"/>[sa] pañcaliṅganilaye</l>
<l n="b"><milestone n="b" unit="column"/>kr̥tajñe rudraparvvate</l>
<l n="c" enjamb="yes"><lb n="N16"/><milestone n="a" unit="column"/>[ja]lāṅgeśvaravāditra</l>
<l n="d"><milestone n="b" unit="column"/>purayor āśramān vyadhāt <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="30" met="anuṣṭubh">
<l n="a"><lb n="N17"/><milestone n="a" unit="column"/>śrīmatsiddheśvarapure</l>
<l n="b"><milestone n="b" unit="column"/>prākpratyacchivapādayoḥ</l>
<l n="c"><lb n="N18"/><milestone n="a" unit="column"/>=devāśramadeśe pi</l>
<l n="d"><milestone n="b" unit="column"/>cakāra śrīmadāśramān <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="31" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="N19"/><milestone n="a" unit="column"/>śrī-campeśvara-dhāmni śrī</l>
<l n="b"><milestone n="b" unit="column"/>-puṇḍarīkākṣadhāmani</l>
<l n="c"><lb n="N20"/><milestone n="a" unit="column"/>śrīpadmanābhanilaye</l>
<l n="d"><milestone n="b" unit="column"/>sa vyadhād āśramān api <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="32" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="N21"/><milestone n="a" unit="column"/>[sa] liṅgapurarudrāṇī</l>
<l n="b"><milestone n="b" unit="column"/>-dhāmani sthirapaṭṭane</l>
<l n="c" enjamb="yes"><lb n="N22"/><milestone n="a" unit="column"/>Anyatra cāśramān pūjā</l>
<l n="d"><milestone n="b" unit="column"/>-vidhaye vividhān vyadhāt <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="33" met="anuṣṭubh">
<l n="a"><lb n="N23"/><milestone n="a" unit="column"/>tasyāntevāsy abhūd vāgmī</l>
<l n="b"><milestone n="b" unit="column"/>sarvvāntevāsināṁ varaḥ</l>
<l n="c"><lb n="N24"/><milestone n="a" unit="column"/>stutānān tadvad ācāryo</l>
<l n="d"><milestone n="b" unit="column"/>mīṣām api mahībhr̥tām <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="34" met="anuṣṭubh">
<l n="a"><lb n="N25"/><milestone n="a" unit="column"/>śrīśānavarmmaṇo yo rhi</l>
<l n="b"><milestone n="b" unit="column"/>hotā śrījayavarmmaṇaḥ</l>
<l n="c"><lb n="N26"/><milestone n="a" unit="column"/>śrīharṣavarmmaṇo bhūya<milestone n="b" unit="column" break="no"/>s</l>
<l n="d">tatsūnor indratejasaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="35" met="anuṣṭubh">
<l n="a"><lb n="N27"/><milestone n="a" unit="column"/>vālyāt prabhr̥ty āvārddhakyāc</l>
<l n="b"><milestone n="b" unit="column"/>chaivācaryyo pi yo [bhavat]</l>
<l n="c"><lb n="N28"/><milestone n="a" unit="column"/>[śu]ddhavaiṣṇavavaṅśyo rthyā<milestone n="b" unit="column" break="no"/>m</l>
<l n="d">hr̥ṣikeśābhidhām adhāt <g ref="sym:doubleBar" type="punctuation">.</g></l>
