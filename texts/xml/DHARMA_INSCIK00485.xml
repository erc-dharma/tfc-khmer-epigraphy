<l n="b"><milestone unit="column" n="b"/>-dyutiḥ pādana[khāṁśubhiḥ]</l>
<l n="c" enjamb="yes"><lb n="A38"/><milestone unit="column" n="a"/>bhāsvān svabhāsā yo 'rkendu</l>
<l n="d"><milestone unit="column" n="b"/>-dīptaṁ merum ivāha[sat</l>
</lg>
                   <lg n="20" met="anuṣṭubh">
<l n="a"><lb n="A39"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>vaśīkr̥tākṣas sadrājyo</l>
<l n="b"><milestone unit="column" n="b"/>duryodhananr̥pāga[me]</l>
<l n="c"><lb n="A40"/><milestone unit="column" n="a"/>ukto yudhiṣṭhirāc chreṣṭho</l>
