                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
<lg n="1" met="indravajrā"><milestone type="pagelike" unit="face" n="A"/><label xml:lang="eng">Face A</label>
<l n="a"><lb n="A1"/><milestone unit="column" n="a"/><g ref="sym:doubleBar-ornate" type="punctuation">.</g><g ref="sym:doubleBar-ornate" type="punctuation">.</g><g ref="sym:circle-bullseye" type="punctuation">.</g>śrīdharmmakāyañ janayan ya ekas</l>
<l n="b"><milestone unit="column" n="b"/>sa[mbhoga]nirmmāṇatanuñ caturdhā</l>
<l n="c"><lb n="A2"/><milestone unit="column" n="a"/>bhinno dhimokṣais sugatādiśāmyāt</l>
<l n="d"><milestone unit="column" n="b"/>sādhya[n tam ī]ḍe jagadekakāyam</l>
</lg>
                   <lg n="2" met="vaṁśasthā">
<l n="a"><lb n="A3"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>jināya śākyeśvarasarvvavedine</l>
<l n="b"><milestone unit="column" n="b"/>yathārtha[dharman da]date prakurvvate</l>
<l n="c"><lb n="A4"/><milestone unit="column" n="a"/>jagaddhitaṁ saṅgham abhedyamānasan</l>
<l n="d"><milestone unit="column" n="b"/>tribhinna[ratnatri] - -  ̆ phalātmane namaḥ</l>
</lg>
                   <lg n="3" met="upajāti">
<l n="a"><lb n="A5"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>lokeśvaro lokahitānulomo</l>
<l n="b"><milestone unit="column" n="b"/>lokān sva[dhām]n[āṣṭabhuj](ai)r dadhad yaḥ</l>
<l n="c"><lb n="A6"/><milestone unit="column" n="a"/>vālāhakāśvo vdhigatāvahaś ca</l>
<l n="d"><milestone unit="column" n="b"/>nānāpa[dānai]s sutarā[ṁ sa] bhāti</l>
</lg>
                   <lg n="4" met="upajāti">
<l n="a" enjamb="yes"><lb n="A7"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>bhoktuṁ bhuvaṁ śrīdharaṇīndravarmma</l>
<l n="b"><milestone unit="column" n="b"/>-devodbhavaś ś[rī]jayavarmmadevaḥ</l>
<l n="c" enjamb="yes"><lb n="A8"/><milestone unit="column" n="a"/>sa mātari śrījayarājacūḍā</l>
<l n="d"><milestone unit="column" n="b"/>maṇau ja[yā]dityapureś[v]arāyām</l>
</lg>
                   <lg n="5" met="upajāti">
<l n="a"><lb n="A9"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>vedāmvaraikendubhir āptarājyo</l>
<l n="b"><milestone unit="column" n="b"/>vitto ya[śo]bhis sa narendravaryyaḥ</l>
<l n="c"><lb n="A10"/><milestone unit="column" n="a"/>kalaṅkamuktendukalābhirāmair</l>
<l n="d"><milestone unit="column" n="b"/>mmuktā[kalā]pair iva digvadhūnām</l>
</lg>
                   <lg n="6" met="vasantatilakā">
<l n="a"><lb n="A11"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>vidviḍdvipendravanitonnatadantasandhes</l>
<l n="b"><milestone unit="column" n="b"/>saukhya[ṁ] spr̥śan raṇaratau kṣaṇapātitāriḥ</l>
<l n="c"><lb n="A12"/><milestone unit="column" n="a"/>yo nāpa tatsukham alaṁ ramaṇīṁ navoḍhāṁ</l>
<l n="d"><milestone unit="column" n="b"/>saṁprāptavān iva vihīnakalāvakāśām</l>
</lg>
                   <lg n="7" met="upajāti">
<l n="a" enjamb="yes"><lb n="A13"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>viśoṣya dr̥ṣṭidviṣatāṁ hr̥damvu</l>
<l n="b"><milestone unit="column" n="b"/>-rāśiṁ kr̥tī yo janamānasāni</l>
<l n="c" enjamb="yes"><lb n="A14"/><milestone unit="column" n="a"/>saṁpūryya lokārthavidhānadīpta</l>
<l n="d"><milestone unit="column" n="b"/>-tr̥ṣṇāgnitaptas sma sadādhiśete</l>
</lg>
                   <lg n="8" met="indravajrā">
<l n="a"><lb n="A15"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>jitvā smaraṁ yas svavapurguṇena</l>
<l n="b"><milestone unit="column" n="b"/>kāntena kāntāhr̥dayaṁ praviṣṭaḥ</l>
<l n="c"><lb n="A16"/><milestone unit="column" n="a"/>nūnaṁ smarasyāspadam ity avekṣya</l>
<l n="d"><milestone unit="column" n="b"/>tasyāpi [k]ī[rtti]ṁ prati sābhilāṣaḥ</l>
</lg>
                   <lg n="9" met="upajāti">
<l n="a"><lb n="A17"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>manośvayor yasya jinaprayāṇe</l>
<l n="b"><milestone unit="column" n="b"/>vi(n)ā [v]i[śeṣaṁ pa]tator na bhedaḥ</l>
<l n="c"><lb n="A18"/><milestone unit="column" n="a"/>bhedo tidūran nagarāgame tu</l>
<l n="d"><milestone unit="column" n="b"/>- -  ̆ [antaḥ]puram āpad aśvaḥ</l>
</lg>
                   <lg n="10" met="anuṣṭubh">
<l n="a"><lb n="A19"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>sūtrajño yas samāhārād</l>
<l n="b"><milestone unit="column" n="b"/>asa = =  ̆ - sane</l>
<l n="c"><lb n="A20"/><milestone unit="column" n="a"/>sādhūpakāribhāvāc ca</l>
<l n="d"><milestone unit="column" n="b"/>sūtraka =  ̆ - hasat</l>
</lg>
                   <lg n="11" met="anuṣṭubh">
<l n="a"><lb n="A21"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>lakṣmyākr̥ṣṭo mado yasya</l>
<l n="b"><milestone unit="column" n="b"/>vidyayā va  ̆ -  ̆ Caḥ</l>
<l n="c"><lb n="A22"/><milestone unit="column" n="a"/>tejasā saghr̥ṇeneva</l>
<l n="d"><milestone unit="column" n="b"/>nīto hasty a  ̆ -  ̆ kān</l>
</lg>
                   <lg n="12" met="anuṣṭubh">
<l n="a"><lb n="A23"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>Ūrdhvam ūrdhvaṅ gatā yasya</l>
<l n="b"><milestone unit="column" n="b"/>kīrttimālā [prabhā]svarā</l>
<l n="c"><lb n="A24"/><milestone unit="column" n="a"/>abhau mūḍhendriyān devān</l>
<l n="d"><milestone unit="column" n="b"/>vodhayantīva -  ̆ yān</l>
</lg>
                   <lg n="13" met="anuṣṭubh">
<l n="a"><lb n="A25"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>sahasradarśanaḥ prāpto</l>
<l n="b"><milestone unit="column" n="b"/>lokapālai  ̆ -  ̆ taiḥ</l>
<l n="c" enjamb="yes"><lb n="A26"/><milestone unit="column" n="a"/>tejonujena yo duṣṭa</l>
<l n="d"><milestone unit="column" n="b"/>-daityeṣu dama[naṁ vya]dhāt</l>
</lg>
                   <lg n="14" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="A27"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>vr̥ṣapriyo mahākṣetra</l>
<l n="b"><milestone unit="column" n="b"/>-vījāropasamuts[uka]ḥ</l>
<l n="c"><lb n="A28"/><milestone unit="column" n="a"/>kṣetrībhūtāṁ bhuvañ cakre</l>
<l n="d"><milestone unit="column" n="b"/>yo dordaṇdda(ha)[lair] dr̥ḍhaiḥ</l>
</lg>
                   <lg n="15" met="anuṣṭubh">
<l n="a"><lb n="A29"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>yasya prajāpateś śrutyā</l>
<l n="b"><milestone unit="column" n="b"/>smr̥tyā supraCi -  ̆ ḥ</l>
<l n="c"><lb n="A30"/><milestone unit="column" n="a"/>vedhomanubhyām ādhikyaṁ</l>
<l n="d"><milestone unit="column" n="b"/>sakalā me(di)[nī gatā]</l>
</lg>
                   <lg n="16" met="anuṣṭubh">
<l n="a"><lb n="A31"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>nivaddhya yaḥ kr̥tayugaṁ</l>
<l n="b"><milestone unit="column" n="b"/>goṣu kr̥ =  ̆ -  ̆ -</l>
<l n="c"><lb n="A32"/><milestone unit="column" n="a"/>karkaśaṁ yugam utsr̥jya</l>
