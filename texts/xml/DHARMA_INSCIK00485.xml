</lg>
                   <lg n="21" met="anuṣṭubh">
<l n="a"><lb n="A41"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>sraṣṭuḥ kāmo bhirāmo 'pi</l>
<l n="b"><milestone unit="column" n="b"/>samāyo me 'pi marmmabhit</l>
<l n="c"><lb n="A42"/><milestone unit="column" n="a"/>Itīva vītamāyo yaḥ</l>
<l n="d"><milestone unit="column" n="b"/>sr̥ṣṭaḥ sraṣṭrā manoramaḥ</l>
</lg>
                   <lg n="22" met="anuṣṭubh">
<l n="a"><lb n="A43"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>tyaktāstravittavr̥ṇddasya</l>
<l n="b"><milestone unit="column" n="b"/>yathārthan dviṣaḍarthiṣu</l>
<l n="c"><lb n="A44"/><milestone unit="column" n="a"/>tr̥ptir na yasya dadr̥[ś]e</l>
<l n="d"><milestone unit="column" n="b"/>yathaiṣān dikṣu dhāvatām</l>
</lg>
                   <lg n="23" met="anuṣṭubh">
<l n="a"><lb n="A45"/><milestone unit="column" n="a"/><g ref="sym:circle-bullseye" type="punctuation">.</g>dravīkr̥tya dviṣatkaṁsaṁ</l>
<l n="b"><milestone unit="column" n="b"/>devavimve nidhāya yaḥ</l>
