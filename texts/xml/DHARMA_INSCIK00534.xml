<p><milestone type="pagelike" unit="face" n="A"/><label xml:lang="eng">Face A</label>
   <lb n="A1"/>Oṁ na[maś ś]i[vā]ya
</p>
                      <lg n="1" met="anuṣṭubh">
<l n="a">namo 'stu manmathaj[it]e</l>
<l n="b">= = = = ⏑ - ⏑ =</l>
<l n="c">= ṣṭeta tāmratāla =</l>
<l n="d"><lb n="A2"/>tr̥tīyākṣyanalārcciṣā <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
                      </lg>
                   <lg n="2" met="anuṣṭubh">
<l n="a">Āsīd = = ⏑ - - =</l>
<l n="b">= = vaṅśasamudbhavā</l>
<l n="c"><lb n="A3"/>piṅsvaṅgrāmavatī [sādhv]ī</l>
<l n="d">= = = = ⏑ - ⏑ = [<g ref="sym:doubleBar-ornate" type="punctuation">.</g>]</l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a"> = = = = ⏑ - - = s</l>
<l n="b">tatsutāḥ khyāta - ⏑ =</l>
<l n="c"><lb n="A4"/>jyeṣṭhaḥ praṇavaśarvvaḥ</l>
<l n="d">= = = = = ⏑ āṣṭayī <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="A5"/>kr̥ṣṇapālasya mahā -</l>
<l n="b">priyāsīt = ⏑ - ⏑ =</l>
<l n="c"> = = keśavabhaṭṭasya</l>
<l n="d"><lb n="A6"></lb>bhavānī kulabh[ūvanī] <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="anuṣṭubh">
<l n="a"> = = = = ⏑ - - =</l>
<l n="b">= = = = raśālinaḥ</l>
<l n="c"><lb n="A7"/>te bhavan bhūtaye - =</l>
<l n="d">= = = = ⏑ - ⏑ = <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="6" met="anuṣṭubh">
<l n="a"> = = [kamvuja]lakṣmyākhyā</l>
<l n="b"><lb n="A8"/>prāṇākhyā prāṇa - ⏑ =</l>
<l n="c"> = = = = ⏑ - - =</l>
<l n="d">= = = = ⏑ - ⏑ = <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="anuṣṭubh">
<l n="a"><lb n="A9"/>hyaṅcandrākhyābhavat sādhvī</l>
<l n="b">pa[tnī tasya] ⏑ - ⏑ =</l>
<l n="c">= = = = ⏑ [saṁ]pattiṁ</l>
<l n="d"><lb n="A10"/>magnān ta udadhārayanan <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="8" met="anuṣṭubh">
<l n="a"> = = = suṣuve sādhvīṁ</l>
<l n="b">sutām ekāṁ prabhāvatīm</l>
<l n="c"><lb n="A11"/>tasmāt keśavabhaṭṭākhyāt</l>
<l n="d">= = = = ⏑ vetti saḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="9" met="anuṣṭubh">
<l n="a">vabhūvānamrabhū[pāla]</l>
<l n="b"><lb n="A12"/>maulimālitaśāsa[naḥ]</l>
<l n="c"> rājā śrī jayavarmmeti</l>
<l n="d">jayaśrīśālitadyutiḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="10" met="anuṣṭubh">
<l n="a"><lb n="A13"/>caturbhujācalorvvī[dhr̥]c</l>
<l n="b">caturbhuja Ivāparaḥ</l>
<l n="c"><lb n="A14"/>caturvidyāsv adhīti yaś</l>
<l n="d">caturvaktra Ivāvabhau <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="11" met="anuṣṭubh"><milestone type="pagelike" unit="face" n="B"/><label xml:lang="eng">Face B</label>
<l n="a" enjamb="yes"><lb n="B1"/>kr̥ṣṇapālo mahendrāri</l>
<l n="b">-mathanākhyām avāptavān</l>
<l n="c">vipraḥ keśavabhaṭṭākhya<lb n="B2" break="no"/>s</l>
<l n="d">sa ca rājapurohitaḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="12" met="anuṣṭubh">
<l n="a">dadhat praṇavaśarvvas sa</l>
<l n="b">śrīnr̥pendrādivikramam</l>
<l n="c"><lb n="B3"/>nāma bhogayutaṁ prāpa</l>
<l n="d">paṁcāṁ varṇṇeṣv adhīśatām <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="13" met="anuṣṭubh">
<l n="a" enjamb="yes"> śivātmā śayanasthāna</l>
<l n="b"><lb n="B4"/>-mandirādhipatir varaḥ</l>
<l n="c" enjamb="yes">rājñe nivedya sabhrātā</l>
<l n="d">pālayat santateḥ puram <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="14" met="anuṣṭubh">
<l n="a"><lb n="B5"/>pūrvve piṅsvaṅbhuvas sīmā</l>
<l n="b">trikaṣṭāmarabhūr abhūt</l>
<l n="c">trailokyanātho yāmye[na]</l>
<l n="d"><lb n="B6"/>kanyākramaś ca paścime <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="15" met="anuṣṭubh">
<l n="a">= stām uttarasīmāsīt</l>
<l n="b">tatrārccā śrīdharasya tā[m]</l>
<l n="c" enjamb="yes"><lb n="B7"/>avardhayat sa nr̥pābhi</l>
<l n="d">-dattadāsādibhiḥ punaḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="16" met="anuṣṭubh">
<l n="a">vananetrakṣites sīmā</l>
<l n="b"><lb n="B8"/>pūrvveṇeyaṁ kaṅtiṅmahī</l>
<l n="c">dakṣiṇena śarakramaḥ</l>
<l n="d">stugvonady api paścime <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="17" met="anuṣṭubh">
<l n="a"><lb n="B9"/>uttare dhruvasīmāsīt</l>
<l n="b">[tārā]ybhūmyavadhiś ca saḥ</l>
<l n="c">svayambhūr abhavat pūrvve</l>
<l n="d"><lb n="B10"/>dakṣiṇe jaya - ⏑ = <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="18" met="anuṣṭubh">
<l n="a"> = hativanasindhuś ca</l>
<l n="b">sīmā paścimato bhavat</l>
<l n="c"><lb n="B11"/>[v]egniṅ sīmottareṇāsīd</l>
<l n="d">golakāṅkitasannidhiḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="19" met="anuṣṭubh">
<l n="a">sthalīkṣoṇīn narapati<lb n="B12" break="no"/>n</l>
<l n="b">te praṇamya yayācire</l>
<l n="c"> = = māntāṁ bhuvam iha</l>
<l n="d">māpya grāma pracakrire <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="20" met="anuṣṭubh">
<l n="a"><lb n="B13"/>pūrvvato vyeknadī sīmā</l>
<l n="b">tasyā yāmyena pārttavoṅ</l>
<l n="c">vleṅ voc nadī tu vārvuṇyā<lb n="B14"/>m</l>
<l n="d">uttare ca bhavad vanaḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="21" met="anuṣṭubh">
<l n="a">tatra te śāmbhavaṁ liṅgaṁ</l>
<l n="b">mahiṣāsuramathinīm</l>
<l n="c"><lb n="B15"/>vidhinā sthāpayām āsur</l>
<l n="d">ambhodhyambhodhiparvvataiḥ <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="22" met="anuṣṭubh">
<l n="a">āvilakṣmāṁ sa santoṣ[ya]</l>
<l n="b"><lb n="B16"/>[veda]priyaṁ mahībhr̥tam</l>
<l n="c"> śrīmahendrārimathanas</l>
<l n="d">syālair bhūpam ayācata <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="23" met="anuṣṭubh">
<l n="a"><lb n="B17"/>= = grāhakanikṣepa</l>
<l n="b">= = sīmāsta pūrvataḥ</l>
<l n="c"> kr̥tā gāḍhanadī yāmye</l>
<l n="d"><lb n="B18"/>= = = paścime bhavat <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="24" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="B27"/>siddhakādhvābhavat so 'py a</l>
<l n="b">-vadhir uttarataḥ kr̥taḥ</l>
<l n="c"><lb n="B19"/>= tvā dhanāni te tāsu</l>
<l n="d">bhūṣu grāmān pracakrire <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="25" met="anuṣṭubh">
<l n="a"> sthāpiteṣv āvilagrāme</l>
<l n="b"><lb n="B20"/>ghr̥tabhāndeṣu pañcasu</l>
<l n="c" enjamb="yes"> pratyekaṁ ṣoḍaśaprastha</l>
<l n="d">-ghr̥tāny evārppitāni tu <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="26" met="anuṣṭubh">
<l n="a"><lb n="B21"/>śvetākṣaṭañ ca gaṇitaṁ</l>
<l n="b">pañcakhārikayā kr̥tam</l>
<l n="c"><lb n="B22"/>kalpitaṁ prativarṣaṁ tad</l>
<l n="d">bhaktyā bhadreśvareśvare <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="27" met="anuṣṭubh">
<l n="a"><lb n="B23"/>= = = = ⏑ - - =</l>
<l n="b">rūpahr̥nmaṅgalaiḥ ⏑ =</l>
<l n="c"> = = = =<lb n="B24"/>⏑ - - =</l>
<l n="d">śrīyaśovarmmanāmadhr̥k <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="28" met="anuṣṭubh">
<l n="a"><lb n="B25"/>= = = = ⏑ - - =</l>
<l n="b">= = = = ⏑ - ⏑ taḥ</l>
<l n="c">devī pūrvvāpadā sā tu</l>
<l n="d"><lb n="B26"/>= = = = ⏑ - ⏑ = <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="29" met="anuṣṭubh">
<l n="a"> = = priyā tasyālaṁ =</l>
<l n="b">= = = = manasvinaḥ</l>
<l n="c"><lb n="B27"/>= = = = ⏑ - - =</l>
<l n="d">= = = = ⏑ nirmmitam <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="30" met="anuṣṭubh">
<l n="a">valādhyakṣas sālaṁnāmā</l>
<l n="b"><lb n="B28"/>sthalīgrāme ca vuddhimān</l>
<l n="c"> vānavidhvuaṣṭabhiś śaivaṁ</l>
<l n="d">liṅgan navam atiṣṭhipat <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
