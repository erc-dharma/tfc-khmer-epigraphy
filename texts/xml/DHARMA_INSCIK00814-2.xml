                <div type="edition" xml:lang="okz-Latn" rendition="class:83231 maturity:83213">
                                      <p><lb n="1"/><num value="1018">1018</num> śaka vyar<unclear>·</unclear> roc<unclear>·</unclear>
                                         <lb n="2"/>A<choice><orig>s</orig><reg>ś</reg></choice>vayuja sauravāra gi nu
                                         <lb n="3"/>vraḥ pāda kamrateṅ<unclear>·</unclear> Añ<unclear>·</unclear>
                                         <lb n="4"/>śriya jayavarmmadeva jvan·
                                         <lb n="5"/>teṅ· ta neḥ ta kamrateṅ·
                                         <lb n="6"/>jag<choice><orig>ā</orig><reg>a</reg></choice>t<unclear>·</unclear> vnaṁ māsa
                                      </p>
