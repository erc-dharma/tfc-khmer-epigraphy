                <div type="edition" xml:lang="okz-Latn" rendition="class:83231 maturity:83213">
<p><milestone type="pagelike" unit="item" n="S"/><label xml:lang="eng">Southern doorjamb</label>
   <lb n="S1"/>{10} smev bhumi pū - man duñ {3}
   <lb n="S2"/>{3} canlyak yau I ta dval vrah śāsana vāp yati {3}
   <lb n="S3"/>vāp loñ khloñ jnval smev bhūmi travāṅ pāk jaṁnva-
   <lb n="S4"/>n vāp śikhāvindu 
</p>
                   <p><milestone type="pagelike" unit="item" n="N"/><label xml:lang="eng">Northern doorjamb</label>
   <lb n="N1"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N2"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N3"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N4"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N5"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N6"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N7"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N8"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N9"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N10"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N11"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N12"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N13"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N14"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N15"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N16"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N17"/><gap reason="lost" extent="unknown" unit="character"/>
                      <lb n="N18"/>tandula {15}
                      <lb n="N19"/>{15} khloñ kāryya
                      <lb n="N20"/>devaparicāra hau qnak {4} paṁmre {3} khloñ {3} ca-
                      <lb n="N21"/>ndrapūra kalpanā yathā {2} gus {8}
                      <lb n="N22"/><g ref="sym:circle-hollow" type="punctuation">.</g>{3} śaka caturthī roc Āṣādha vudhavāra nu mān vraḥ śāsana
                      <lb n="N23"/>dhūli vraḥ pāda dhūli jeṅ vraḥ kamrateṅ Añ ta steñ Añ
                      <lb n="N24"/>Ācāryya nā do nu kaṁsteṅ Añ śrīvīrendravarmma pre Oy
                      <lb n="N25"/>śapata vāp prāṇi taṁmrvac {4} nu mratāñ śivavrāhmaṇa
                      <lb n="N26"/>khloñ cāñ pre mok mel Aṁruṅ bhūmi vnaṁ kantāl
                      <lb n="N27"/>ta vyatta gi mratāñ {9} pi {2} ta vraḥ
                      <lb n="N28"/>kamrateṅ Añ Āy travāṅ rvvau nu bhūmi {6}
                      <lb n="N29"/>praśasta pre saṅ=(g)o[l]· Aṁruṅ ta ti saṅ hoṅ Oy viṅ ta vraḥ
                      <lb n="N30"/>Āy travāṅ rvvau {7} mrateñ khloñ - vnaṁ
                      <lb n="N31"/>kantāl khloñ kāryya vraḥ kamrateṅ mūla devaparicāra si kaṁpañ
                      <lb n="N32"/>tai {7}p trak tai rek
</p>
</div>
