                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83211">
<lg n="1" met="āryā">
<l n="ab"><lb n="1"/><gap reason="lost" quantity="1" unit="character"/>so dvādaśarātrau <space/>
   jyeṣṭhendāv atitulodite kr̥ṣṇe</l>
<l n="cd"><lb n="2"/><supplied reason="lost">ca</supplied>turekaṣadgate 'bde <space/>
   devīyaṁ sthāpitā bhiṣajā <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="2" met="sragdharā">
<l n="a"><lb n="3"/><supplied reason="lost">śrī</supplied>vidyādhāraṇīti prathitataram idan nāmadheyan tu yasyāḥ</l>
<l n="b"><lb n="4"/>rodasyos sādhakānāṁ satatam urudhiyā dhyeyam ātmaprabuddhyai</l>
<l n="c"><lb n="5"/>tena prajñaiṣiṇaitad bhuvi vividhadhanan dānaśīlena tasyai</l>
<l n="d"><lb n="6"/>prādāyy etāvad eva praṇihitamanasā sādhane satpadavyāḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="āryā">
<l n="ab"><lb n="7"/>Āyur mmāsasahasraṁ <space/>
  sañjīvya bhiṣagvaras tanum amuñcat·</l>
<l n="cd"><lb n="8"/>pauṣe prathame divase <space/>
   navadviṣadvibhūtaśakābde <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                 
