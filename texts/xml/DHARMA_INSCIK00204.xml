                <div type="edition" xml:lang="okz-Latn" rendition="class:83231 maturity:83213">
<p>
   <lb n="1"/>{18} vraḥ pāda dhūli je<lb n="2" break="no"/>[ṅ] {12} caturmukha vraḥ
   <lb n="3"/>{14} Añ vidyā {3}
   <lb n="4"/>{12} guṇadoṣadarśśi <g ref="sym:bullet-hollow" type="punctuation">.</g> nau qna
   <lb n="5"/>{8} candrapura phoṅ vvaṁ Āc ti Āyatta ta
   <lb n="6"/>{7}la phoṅ vvaṁ Āc ti mān pi dā po{1}
   <lb n="7"/>{9} mān qnak ta khmi jā śatru ta A{1}
   <lb n="8"/>{8}la thve pujā kaṁmrateṅ jagat
   <lb n="9"/>{7} vvaṁ thve toy vraḥ niyama ta {2}
   <lb n="10"/>{7} (u) ttamasaha <g ref="sym:bullet" type="punctuation">.</g>
   <lb n="11"/>{7} man thvāy jā vraḥ dharmma kamra<lb n="12" break="no"/>[teṅ] {6}rjitāśrama nu Upāya neḥ {3}
   <lb n="13"/>{5} pu {3} y {12}
   <lb n="14"/>{3} ta {16} vraḥ
   <lb n="15"/>{4} pa {15}
   <lb n="16"/>{20}
   <lb n="17"/>{7} gava {13}
   <lb n="18"/>{7} Añ {9}
   <lb n="19"/>{9} <g ref="sym:bullet-hollow" type="punctuation">.</g> nau qnak ta {9}
   <lb n="20"/>{5} vraḥ candrāditya mān {3}
   <lb n="21"/>{5} dvātriṁśa narakk <g ref="sym:bullet-hollow" type="punctuation">.</g> tarāp vr{1}
   <lb n="22"/>{12} i {7}
</p>     
