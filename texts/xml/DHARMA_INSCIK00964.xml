        <body>
                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
<lg n="1" met="anuṣṭubh">
<l n="a"><lb n="1"/><milestone unit="column" n="a"/>Ākīrṇṇakīrttipuñjasya</l>
<l n="b"><milestone unit="column" n="b"/>rājñaś śrīśānavarmmaṇaḥ</l>
<l n="c"><lb n="2"/><milestone unit="column" n="a"/>naptā śrīharṣavarmmāsa</l>
<l n="d"><milestone unit="column" n="b"/>labdhasiṅhāsanaḥ kramāt <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="3"/><milestone unit="column" n="a"/>nr̥ttatūryyādisaṁpannāṁ</l>
<l n="b"><milestone unit="column" n="b"/>śivikāṁ ratnabhūṣitāṁ</l>
<l n="c"><lb n="4"/><milestone unit="column" n="a"/>sa sātapatrāṁ prahinoc</l>
<l n="d"><milestone unit="column" n="b"/>chrīmadamrātakeśvare <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="5"/><milestone unit="column" n="a"/>paścāc ca śāmbhavakośaṁ</l>
<l n="b"><milestone unit="column" n="b"/>vaddhaprakaraṇair yyutam</l>
<l n="c"><lb n="6"/><milestone unit="column" n="a"/>sa śrīdhāreśvare dadyān</l>
<l n="d"><milestone unit="column" n="b"/>nāṭyagītādisaṅkulam <g ref="sym:doubleBar-ornate" type="punctuation">.</g></l>
</lg>
</div>
