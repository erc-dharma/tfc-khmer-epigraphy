                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
                   <lg n="1" met="unidentified">
<l n="a"><lb n="1"/>- - - kā śr - - - - - - - - - -</l>
<l n="b">- - - - - - - - - - - -</l>
<l n="c"><lb n="2"/>- - - - nr̥patiś śrīyaśodharaś śrī -</l>
<l n="d">- - - - - - - - - - - - - -</l>
</lg>
                   <lg n="2" met="vasantatilakā">
<l n="a"><lb n="3"/>- - ⏑ - lasalilasthitakalpitānā</l>
<l n="b">- - ⏑ - ⏑ ⏑ ⏑ - ⏑ ⏑ - ⏑ - -</l>
<l n="c"><lb n="4"/>[A]vdaṁ samudraśaśimūrttisakārttikāṇā</l>
<l n="d">- - ⏑ - ⏑ ⏑ ⏑ - ⏑ ⏑ - ⏑ - -</l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="5"/>pañcaviṅśatipraṣṭhan tat</l>
<l n="b">tandulañ ca dine dine</l>
<l n="c">= = = = = - - =</l>
<l n="d">= = = = ⏑ - ⏑ -</l>
</lg>
                   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="6"/>sarāṅgi pañca rūpyāni</l>
<l n="b">Ekaikapañcapra[s]thakaṁ</l>
<l n="c">= = = = = - - =</l>
<l n="d">= = = = ⏑ - ⏑ -</l>
</lg>
                   <lg n="5" met="śārdūlavikrīḍita">
<l n="a"><lb n="7"/>kṣetragrāma ⏑ gur naro pi ca kr̥tan naivedyakaṁ kalpaṇā</l>
<l n="b">- - - ⏑ ⏑ - ⏑ - ⏑ ⏑ ⏑ - - - ⏑ - - ⏑ -</l>
<l n="c"><lb n="8"/>dhānyaṁ bhojyatirañ ca tanduladine rūpyaṁ sarāṅgim garaiḥ</l>
<l n="d">- - - ⏑ ⏑ - ⏑ - ⏑ ⏑ ⏑ - - - ⏑ - - ⏑ -</l>
</lg>
