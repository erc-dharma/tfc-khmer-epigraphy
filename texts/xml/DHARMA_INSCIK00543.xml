                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
                   <lg n="1" met="anuṣṭubh">
<l n="a"><lb n="1"/><milestone n="a" unit="column"/>mantrī mantrādikr̥tyeṣu</l>
<l n="b"><milestone n="b" unit="column"/>[śās]tā śāstra[vi]darśane</l>
<l n="c"><lb n="2"/><milestone n="a" unit="column"/>yo babhūva vibhur bhartu<milestone n="b" unit="column" break="no"/>r</l>
<l n="d">bhr̥tyas sarvvasukhārppaṇe <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
     <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="3"/><milestone n="a" unit="column"/>sarāgaśrīr atiśrāntaḥ</l>
<l n="b"><milestone n="b" unit="column"/>kānto me 'yam itīva yam</l>
<l n="c"><lb n="4"/><milestone n="a" unit="column"/>Anīrṣyā śāstrapīyūṣa<milestone n="b" unit="column" break="no"/>m</l>
<l n="d">apāyayata bhāratī <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="5"/><milestone n="a" unit="column"/>hemadolākaraṅkāsi</l>
<l n="b"><milestone n="b" unit="column"/>-bhr̥ṅgārāmatramekhalāḥ</l>
<l n="c"><lb n="6"/><milestone n="a" unit="column"/>māyūracchatram anyāṁś ca</l>
<l n="d"><milestone n="b" unit="column"/>bhogān bhartur avāpa yaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="7"/><milestone n="a" unit="column"/>viṣṇuṁ śrīpuṇḍarīkākṣa</l>
<l n="b"><milestone n="b" unit="column"/>-nāmānaṁ namatāṁ mude</l>
<l n="c" enjamb="yes"><lb n="8"/><milestone n="a" unit="column"/>-C ādasthāpitātmīya</l>
<l n="d"><milestone n="b" unit="column"/>-bhaktis sa pratyatiṣṭhipat <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="anuṣṭubh">
<l n="a"><lb n="9"/><milestone n="a" unit="column"/>sa [co]vāceti tāṁ vācaṁ</l>
<l n="b"><milestone n="b" unit="column"/>vācaspativicakṣaṇaḥ</l>
<l n="c" enjamb="yes"><lb n="10"/><milestone n="a" unit="column"/>Ācāracaturaś cāru</l>
<l n="d"><milestone n="b" unit="column"/>-caritācaraṇācyutaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="6" met="anuṣṭubh">
<l n="a"><lb n="11"/><milestone n="a" unit="column"/>Atra śrī[pu]ṇ[ḍ]arīkākṣo</l>
<l n="b"><milestone n="b" unit="column"/>rakṣyatān dharmmakāṅkṣibhiḥ</l>
<l n="c"><lb n="12"/><milestone n="a" unit="column"/>dharmmeṇa rakṣyate rakṣa<milestone n="b" unit="column" break="no"/>nn</l>
<l n="d">iti satyaṁ vicintyatām <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="anuṣṭubh">
<l n="a"><lb n="13"/><milestone n="a" unit="column"/>ye haranti harer atra</l>
<l n="b"><milestone n="b" unit="column"/>kiñcid dāsādikalpitam</l>
<l n="c"><lb n="14"/><milestone n="a" unit="column"/>Avīcyādiṣu [pa]cyante</l>
<l n="d"><milestone n="b" unit="column"/>te yāvac candrabhāskarau <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="8" met="anuṣṭubh">
<l n="a"><lb n="15"/><milestone n="a" unit="column"/>[rakṣanti ye sadā] tasya</l>
<l n="b"><milestone n="b" unit="column"/>tad eva sukr̥tārthinaḥ</l>
<l n="c"><lb n="16"/><milestone n="a" unit="column"/>====-+-Cai<milestone n="b" unit="column" break="no"/>s</l>
<l n="d">santas te vaiṣṇave pade <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
