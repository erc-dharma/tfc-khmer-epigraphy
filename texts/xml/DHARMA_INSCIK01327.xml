             <p>
                 <lb n="1"/>śaka ri <unclear>g</unclear>i <gap reason="lost" quantity="1" unit="character"/> Indratapas· <unclear><g ref="sym:bullet-middle" type="punctuation">.</g></unclear> Indra ta pat<unclear>i siṁha</unclear> <g ref="sym:bar" type="punctuation">.</g>
             </p>
         </div>
