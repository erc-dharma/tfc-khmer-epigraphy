<div type="textpart" n="A" xml:lang="san-Latn"><head xml:lang="eng">Face</head>
   <p><lb n="A0"/>Oṁ</p>
   <lg n="1" met="anuṣṭubh">
<l n="a" enjamb="yes"><lb n="A1"/><milestone unit="column" n="a"/>namo vimalavālendu</l>
<l n="b"><milestone unit="column" n="b"/>-lekhādiptajatājite</l>
<l n="c" enjamb="yes"><lb n="A2"/><milestone unit="column" n="a"/>janitāmvujayonyavja</l>
<l n="d"><milestone unit="column" n="b"/>-netracchatrāya śambhave</l>
</lg>
   <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="A3"/><milestone unit="column" n="a"/>śrīddhaḥ dharmmapradeśo 'sau</l>
<l n="b"><milestone unit="column" n="b"/>yasya deśo syaninditaḥ</l>
<l n="c"><lb n="A4"/><milestone unit="column" n="a"/>rudraśaktisamākīrṇṇo</l>
<l n="d"><milestone unit="column" n="b"/>rudraloka Ivāparaḥ</l>
</lg>
   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="A5"/><milestone unit="column" n="a"/>śrīṣṭaśrīśānavarmmā yo</l>
<l n="b"><milestone unit="column" n="b"/>vālasvasya sa vīryyadhr̥k</l>
<l n="c"><lb n="A6"/><milestone unit="column" n="a"/>sārassvatiñ ca saṁyogāt</l>
<l n="d"><milestone unit="column" n="b"/>putr[ī]ṁ sārassvatīm ivaḥ</l>
</lg>
   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="A7"/><milestone unit="column" n="a"/>putrapautrakulān sarvvān</l>
<l n="b"><milestone unit="column" n="b"/>dhanyaṁ saṁrakṣitaṁ dadat</l>
<l n="c"><lb n="A8"/><milestone unit="column" n="a"/>dāsadāsiñ ca dravyāni</l>
<l n="d"><milestone unit="column" n="b"/>vahudhānyañ ca rakṣitaṁ</l>
</lg>
   <lg n="5" met="anuṣṭubh">
<l n="a"><lb n="A9"/><milestone unit="column" n="a"/>Ājñāmātr̥surūpakām</l>
<l n="b"><milestone unit="column" n="b"/>eva naniñ cā satipati</l>
<l n="c"><lb n="A10"/><milestone unit="column" n="a"/>pancavelā tathā yatraṁ</l>
<l n="d"><milestone unit="column" n="b"/>sabhūṣañ ca vicitrakaṁ</l>
</lg>
   <lg n="6" met="anuṣṭubh">
<l n="a"><lb n="A11"/><milestone unit="column" n="a"/>tandulaṁ daśadronan tad</l>
<l n="b"><milestone unit="column" n="b"/>bhakṣapākaṁ dine dine</l>
<l n="c"><lb n="A12"/><milestone unit="column" n="a"/>madhuparkaṁ tathā vya – n</l>
<l n="d"><milestone unit="column" n="b"/>nārikelasamodakaṁ</l>
</lg>
   <lg n="7" met="anuṣṭubh">
<l n="a"><lb n="A13"/><milestone unit="column" n="a"/>bhairivādyā – gandharvāḥ</l>
<l n="b"><milestone unit="column" n="b"/>gandhakaṁ puṣpacitravā</l>
<l n="c"><lb n="A14"/><milestone unit="column" n="a"/>pūjātriṣkāla Ityuktaṁ</l>
<l n="d"><milestone unit="column" n="b"/>tasmāt sārassvatin dadat</l>
</lg>
   <lg n="8" met="anuṣṭubh">
<l n="a"><lb n="A15"/><milestone unit="column" n="a"/>rudraloka tathā rājyaṁ</l>
<l n="b"><milestone unit="column" n="b"/>bhūmiṁ saṁrakṣitāṁ kulaiḥ</l>
<l n="c" enjamb="yes"><lb n="A16"/><milestone unit="column" n="a"/>prasādaṁ bhūpater vāla</l>
<l n="d"><milestone unit="column" n="b"/>-putr[ī]ṁ sārassvatin dadat</l>
</lg>
   <lg n="9" met="anuṣṭubh">
<l n="a"><lb n="A17"/><milestone unit="column" n="a"/>bhavapurābhidhāvarṇo</l>
<l n="b"><milestone unit="column" n="b"/>vikrāntagrāmasambhavaḥ</l>
<l n="c"><lb n="A18"/><milestone unit="column" n="a"/>santanvayasyasakulān</l>
<l n="d"><milestone unit="column" n="b"/>tatākavV - tiṣ[ṭha]ti</l>
</lg>
   <lg n="10" met="anuṣṭubh">
<l n="a"><lb n="A19"/><milestone unit="column" n="a"/>nr̥tagītapadakālaṁ</l>
<l n="b"><milestone unit="column" n="b"/>liṅgaṁ bhaktyā dine dine</l>
<l n="c"><lb n="A20"/><milestone unit="column" n="a"/>śrīnilakantha Iti khyātaḥ</l>
<l n="d"><milestone unit="column" n="b"/>seve vaiprahuti ⏑ vit</l>
</lg>
</div>
                   <div type="textpart" n="B" xml:lang="okz-Latn"><head xml:lang="eng">Face</head>
                   <p xml:lang="san-Latn"><lb n="B0"/>Oṁ</p>
                      <p xml:lang="san-Latn">
   <lb n="B1"/>namo vimalavālendulekhādiptaja[tājite]</p>
                      <p>
                         <lb n="B2"/>neḥ gi roḥ śākha pi Añ ta jmaḥ loñ myaṅ sruk chok valval {3}
                         <lb n="B3"/>bhūmi vikranta dharmmapura prahāra man vraḥ pāda kaṁmrateṅ Añ svey vraḥ rā-
                         <lb n="B4"/>jya chnāṁ vyar pre Añ loñ viṣaya dharmapura prahāra pre Oy {2}
                         <lb n="B5"/>{2}r mās prāk sarvadravya pi thvāy ta rājakula phoṅ vāp si {3}
                         <lb n="B6"/>vāp {2} vāp {2} nu vāp nā {1} neḥ qnak viṣaya syaṅ ta paripāla {3}
                         <lb n="B7"/>{5}ri {2} danhuṁ I trayvaṅgaṁ 5 kundaka mās liṅ I {2} jyaṅ I
                         <lb n="B8"/>{2} 10 kra{1}y I vnuk 10 {2} I canlyak {2} 3 neḥ taṅvāy ti qnak viṣa-
                         <lb n="B9"/>ya dharmmapura Oy nu Añ dār dravya ta roḥ neḥ steṅ guṇādhyakṣa O[y]
                         <lb n="B10"/>Añ paṅgaṁ thpvaṅ nivedana vraḥ karuṇā prasāda dār man vvaṁ Āc ti Oy dravya ta Aṁ-
                         <lb n="B11"/>pāl neḥ khmi Oy bhūmi {1} dravya roḥ phoṅ Añ paṅgaṁ thpvaṅ nivedana vraḥ karuṇā
                         <lb n="B12"/>pre Añ yok {1} thvāy saṁnvat khmi Oy dharmapura nu prahāra vraḥ karuṇā dār bhū-
                         <lb n="B13"/> mi man Añ {2} nuk yok taṅvāy mān pandval ta {3}nā catvā-
                         <lb n="B14"/>ri pre Oy raṅvāṅ nu vraḥ sabhā hau thve caṅvat bhūmi dharmmapura prahāra pre
                         <lb n="B15"/>Oy gnā pi dravya Añ ta Aṁpāl neḥ siddhi vvaṁ Āc ti mān vāda bhūmi neḥ ma-
                         <lb n="B16"/>n kamrateṅ Añ śrīnilakantha daṁnuk vrāhma śūnya dau Añ paṅgaṁ thpvaṅ ni-
                         <lb n="B17"/>vedana vraḥ karuṇā Oy prasāda bhūmi dharmmapura prahāra ta Añ {2}
                         <lb n="B18"/>{2} cat sruk dharmapura viṅ Añ qu{2} kamrateṅ jagat nilakantha kamrateṅ
                         <lb n="B19"/>jagat śivaliṅga ti {3} nu rūpa qme Añ {2} duk jā Āsna cat sruk prahāra chvat caṁnat
                         <lb n="B20"/>chok valval {1}āṅ purvvapaścimadakṣiṇottara Oy ta teṅ sārassvati ta kva-
                         <lb n="B21"/>n Añ kaṁsteṅ {2} vraiy sruk vikrāntapura ta jā saṁvandhi ta Añ nu kvan
                         <lb n="B22"/>{2} neḥ loñ Ambañ loñ rudraśānti teṅ candra teṅ pavitra loñ paramā
                         <lb n="B23"/>{2} gi nā Añ Oy sruk deśa neḥ phoṅ nu vraḥ pūjā {5}
                         <lb n="B24"/>{3} ta rūpa qme Añ {2} Añ teṅ sārasvati paripā-
                         <lb n="B25"/>la caṁ pradvān vvaṁ Āc ti mān nāk ta Amāryyāda ta pari{2}
                         <lb n="B26"/>{2} qnak ta lap kalpanā Añ ta jana svey {1} pa {1}
                         <lb n="B27"/>{3} svey na {4}
                         <lb n="B28"/>candrāditya {2}
                      </p>
</div>
