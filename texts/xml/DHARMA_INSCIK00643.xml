<l n="b"><milestone n="b" unit="column"/>bhasmaśubhro jvalajjaṭaḥ</l>
<l n="c"><lb n="12"/><milestone n="a" unit="column"/>śāradāmbhodabhaktāṅgas</l>
<l n="d"><milestone n="b" unit="column"/>svarṇṇamurddhādrirād iva <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="anuṣṭubh">
<l n="a"><lb n="13"/><milestone n="a" unit="column"/>vande pitāmahaṁ sāmyāt</l>
<l n="b"><milestone n="b" unit="column"/>smitāsyāpjacatuṣṭayam</l>
<l n="c"><lb n="14"/><milestone n="a" unit="column"/>cat[urdik] = = = gatāṁ</l>
<l n="d"><milestone n="b" unit="column"/>samaṁ vaktum ivāśiṣam <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="8" met="anuṣṭubh">
