<l n="d"><milestone n="b" unit="column"/>śrāntasyāhlādanād iva <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="9" met="anuṣṭubh">
<l n="a"><lb n="17"/><milestone n="a" unit="column"/>= = = = = tā rudra</l>
