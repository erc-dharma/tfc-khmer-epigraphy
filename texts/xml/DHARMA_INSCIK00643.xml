                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:83213">
                   <lg n="1" met="anuṣṭubh">
<l n="a"><lb n="1"/><milestone n="a" unit="column"/><g ref="sym:bullet-hollow" type="punctuation">.</g><g ref="sym:doubleBar" type="punctuation">.</g>pāntu vo vāsudevasya</l>
<l n="b"><milestone n="b" unit="column"/>pādapaṅkajapāṅsavaḥ</l>
<l n="c" enjamb="yes"><lb n="2"/><milestone n="a" unit="column"/>bhuvanatritayotpatti</l>
<l n="d"><milestone n="b" unit="column"/>-sthitisaṁhārahetavaḥ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
     <lg n="2" met="anuṣṭubh">
<l n="a"><lb n="3"/><milestone n="a" unit="column"/>vande trivikramaṁ yena</l>
<l n="b"><milestone n="b" unit="column"/>trailokyan tat sthitānvitam</l>
<l n="c"><lb n="4"/><milestone n="a" unit="column"/>mamedan na parasyeti</l>
<l n="d"><milestone n="b" unit="column"/>svapadais tribhir aṅkitam <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="anuṣṭubh">
<l n="a"><lb n="5"/><milestone n="a" unit="column"/>namo 'stu padmanābhāya</l>
<l n="b"><milestone n="b" unit="column"/>sarvvasarggasisr̥kṣayā</l>
<l n="c" enjamb="yes"><lb n="6"/><milestone n="a" unit="column"/>nijanābhyudbhavāmbhoja</l>
<l n="d"><milestone n="b" unit="column"/>-prādurbhūtasvayambhuve <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="anuṣṭubh">
<l n="a"><lb n="7"/><milestone n="a" unit="column"/>namo 'stu yogi[h]r̥tpad[ma]</l>
<l n="b"><milestone n="b" unit="column"/>= = ve 'pi madhudviṣe</l>
<l n="c" enjamb="yes"><lb n="8"/><milestone n="a" unit="column"/>surāsuraśiraścumvi</l>
<l n="d"><milestone n="b" unit="column"/>-[padapaṅka]ja[r]eṇave <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="anuṣṭubh">
<l n="a"><lb n="9"/><milestone n="a" unit="column"/>vande śrīpuṇḍarīkākṣa</l>
<l n="b"><milestone n="b" unit="column"/>= = = = ⏑ - ⏑ dam</l>
<l n="c"><lb n="10"/><milestone n="a" unit="column"/>kṣitaṁ bhuvam ivoddhartuṁ</l>
<l n="d"><milestone n="b" unit="column"/>[ś]r[ī]yaśodharaparvvate <g ref="sym:doubleBar" type="punctuation">.</g></l>
