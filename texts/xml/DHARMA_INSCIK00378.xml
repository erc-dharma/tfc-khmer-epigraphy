                <div type="edition" xml:lang="okz-Latn" rendition="class:83231 maturity:83213">
                   <p>
                   <lb n="1"/>{10} phoṅ <g ref="sym:bullet-hollow" type="punctuation">.</g> kñuṁ vāp hen
                      <lb n="2"/>{8} vāp prabhāsita vāp hari-
                      <lb n="3"/>ghoṣa {8} nu steñ paramaśivaruci
                      <lb n="4"/>vāp rucibhāva steñ {8} śrīśikhā mrateñ vidyā-
                      <lb n="5"/>panditta śramaṇāditya {2} kaṁpi na {5} hāryyaṁ nr̥penāpi
                      <lb n="6"/>{8} <g ref="sym:bullet-hollow" type="punctuation">.</g>
                   </p>
<lg n="1" met="anuṣṭubh" xml:lang="san-Latn">
<l n="a">svadattāṁ paradattāṁ vā</l>
<l n="b">yo haret tu vasundharām</l>
<l n="c"><lb n="7"/>varṣaśatasahasrāṇi</l>
<l n="d">hyantum āpnoti kilviṣaṁ <g ref="sym:doubleBar" type="punctuation">.</g></l>
</lg>
  <p>qnak ta {1}
     <lb n="8"/>parihāra {2} bhūmi ta vraḥ kamrateṅ Añ vinaya jyaṅ I
     <lb n="9"/>{1} vraḥ {5} qnak kaṁluṅ kanloṅ cāp qnak vinaya liṅ
     <lb n="10"/>{4} vraḥ kamrateṅ {3} ti purvva pra-
     <lb n="11"/>sapp {2} ti dakṣina pra[sap] {2} drapattaṁ ti
     <lb n="12"/>paścima tarāp chdiṅ {4} gol
     <lb n="13"/>ti Uttara {1} k {5} neḥ gi
     <lb n="14"/><gap reason="lost" extent="unknown" unit="character"/>
  </p>                 
