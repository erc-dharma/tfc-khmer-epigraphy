<lg n="1" met="anuṣṭubh">
 <l n="a"><lb n="1"/><supplied reason="lost">śivan namāmi yo</supplied> 'haṅ sa</l>
   <l n="b">yo haṅsa-parikīrttitaḥ</l>
 <l n="c">Iti tattva-vidaḥ prāhu<lb n="2" break="no"/>r</l> 
   <l n="d"><seg met="====-+"><gap reason="lost" quantity="6" unit="character"/></seg>namaḥ</l>
</lg>
<lg n="2" met="upajāti">
