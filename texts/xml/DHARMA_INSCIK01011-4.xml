<l n="b">santāna-jāto <lb n="3"/> <seg met="--+-+="><gap reason="lost" quantity="6" unit="character"/></seg></l>   
<l n="c"><unclear>yo</unclear> rājya-bhak candra-giri-graheṣu</l>
<l n="d">śrī-sūryyavarmmāvani<lb n="4" break="no"/><supplied reason="lost">pendra-sūnuḥ</supplied></l>
