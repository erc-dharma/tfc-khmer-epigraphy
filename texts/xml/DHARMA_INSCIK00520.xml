                <div type="edition" xml:lang="san-Latn" rendition="class:83231 maturity:00000">
<lg n="1" met="anuṣṭubh">
    <l n="a"><lb n="1"/><milestone unit="column" n="a"/>Iha liṅga-pratiṣṭhātu<milestone unit="column" n="b" break="no"/>r</l>
    <l n="b">bhojasyāśīti-varṣiṇaḥ</l>
    <l n="c" real="-+-++--+"><lb n="2"/><milestone unit="column" n="a"/>triśūla-mūle nihitā</l>
    <l n="d"><milestone unit="column" n="b"/>daṁṣṭrās tā yā mukha-cyutāḥ</l>
</lg>
</div>
