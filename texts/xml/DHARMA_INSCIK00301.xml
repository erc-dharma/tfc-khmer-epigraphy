                <div type="edition" xml:lang="xhm-Latn" rendition="class:83231 maturity:83213">
                   <lg n="1" met="brahmagīti">
<l n="a"><lb n="1"/>sabbhamasa suostī</l>
<l n="b">śrī sabva śrī maṅgalā</l>
<l n="c">bahula braḥ jaiyyā</l>
<l n="d">toy sārddhātirek Ai <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: to.y -->
</lg>
                   <lg n="2" met="brahmagīti">
<l n="a">nā 1623</l>
<l n="b">sak naeḥ I masaeña nai</l><!-- kuch: s’’ak  -->
<l n="c">dvāradasa roja māgha mai</l>
<l n="d">dibāra thṅai braḥhassatī <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="brahmagīti">
<l n="a">bi temma naeḥ Eṅ nā</l>
<l n="b">toy gāṭhā braḥ pāḷī</l><!-- kuch: to.y -->
<l n="c">loek sarasera buddhī</l>
<l n="d">pada muḥhni braṁhmagitta <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="brahmagīti">
<l n="a"><lb n="2"/>Añ khñuṁma thvāy pubhbhā</l><!-- kuch: thvā.y -->
<l n="b">braḥ bhaggavā sarbvejña</l>
<l n="c">sṭhita trāsa yala {2}</l>
<l n="d">staeca guṅa gita phcaña māra nai <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="brahmagīti">
<l n="a">paduṁma krabvaṁma sqāta</l>
<l n="b">thvāy braḥ pādda sarbvejña thlai</l><!-- kuch: thvā.y -->
<l n="c">luta loeka dassa kara krai</l>
<l n="d">phcaṅa prabai tāka sirasīy<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: sirasī.y -->
</lg>
                   <lg n="6" met="brahmagīti">
<l n="a">khñuṁma krāppa kromma braḥ pādda</l><!-- kuch: krā˘ppa -->
<l n="b">Abbhīvādavaravandī</l>
<l n="c">gita thvāy dau braḥ śrī</l><!-- kuch: thvā.y -->
<l n="d">ratna traiya śrīkkāllā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="brahmagīti">
<l n="a">ruṅa rīoeṅa pālaṁṅ<lb n="3"/>bejña</l><!-- kuch: pālaṁ.ṅ -->
<l n="b">bīycitra sreca riccanā</l><!-- kuch: bī.ycitra -->
<l n="c">chlāka chlov jā bhñī phkā</l>
<l n="d">parapūr puon dantappa hāta <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: h˘āta -->
</lg>
                   <lg n="8" met="brahmagīti">
<l n="a">tāmma thpūṅa syiṅa grupp bārṇna</l><!-- kuch: gru˘pp -->
<l n="b">lqa Iscāryya chluḥ cravāttha</l>
<l n="c">keta phsaṁ bodhisatva</l>
<l n="d">braḥ guṅa sṭhita jhnāḥ māra phoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="9" met="brahmagīti">
<l n="a">thvāy braḥ sākhyamnī</l><!-- kuch: thvā.y -->
<l n="b">no braḥ śrīĀra sota hoṅa</l>
<l n="c">trassa dharmma nāṁm satva phoṅa</l><!-- kuch: trăssa ; nāṁ.m -->
<l n="d">knuṅa ganlaṅa kālpa<lb n="4"/>naeḥ nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="10" met="brahmagīti">
<l n="a">khñuṁma krāp kromma braḥ pādda</l>
<l n="b">Abbhīvādavaravandā</l>
<l n="c">praṇaṁ braḥ sāstā</l>
<l n="d">pañcabuddhā ratna ta trai <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="11" met="brahmagīti">
<l n="a">tejaḥ Aña khñuṁ thvāy</l><!-- kuch: thvā.y -->
<l n="b">dasakara kāya Isa hradaiy</l><!-- kuch: hradai.y -->
<l n="c">phjaṁma phcaṅa gaṁmpaṅa thlai</l>
<l n="d">citra mūla maiy nai prāthnā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: mai.y -->
</lg>
                   <lg n="12" met="brahmagīti">
<l n="a">gīttha thvāỵ braḥ cettīỵ</l><!-- kuch: thvā.y, cettī.y -->
<l n="b">culāmnī traitriṅsa nā</l>
<l n="c">sāṅa duka braḥ kessā</l>
<l n="d">Is debvatā thvāy paṅgaṁmma <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: thvā.y -->
</lg>
                   <lg n="13" met="brahmagīti">
<l n="a">thvāỵ braḥ prattīmā</l>
<l n="b">mā<lb n="5"/>sa no nā sṭhāṇa Asraṁma</l>
<l n="c">braḥ traisarṇāgaṁ</l>
<l n="d">jā bvuṁnak nai satva phoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: bvuṁn’’ak -->
</lg>
                   <lg n="14" met="brahmagīti">
<l n="a">thvāy braḥ buddharuppa</l><!-- kuch: thvā.y -->
<l n="b">braḥ sadhūpa caittī hoṅa</l>
<l n="c">thvāỵ grupa braḥ jīỵ phoṅa</l><!-- kuch: thvā.y ; jī.y -->
<l n="d">braḥ sādha gaṅ braḥ gohā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: g’’aṅ -->
</lg>
                   <lg n="15" met="brahmagīti">
<l n="a">tejaḥ Aña khñuṁ thvāy</l><!-- kuch: thvā.y -->
<l n="b">spaṅakāca kāya kappa hātthā</l>
<l n="c">luta loeka Isa Aṅgā</l>
<l n="d">thvāỵ vandā sureca hoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: thvā.y -->
</lg>
                   <lg n="16" met="brahmagīti">
<l n="a">thvāy hey khñuṁ dūla phtiṅa</l><!-- kuch: thvā.y ; he.y -->
<l n="b">sūm Oy tyi<lb n="6"/>ṅa Isa Āra phoṅa</l><!-- kuch: O.y -->
<l n="c">jāttisarañāṇa hoṅa</l>
<l n="d">kuṁ kaṁmp’’āṅa bhlāṁṅa bhlecca loey <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: kaṁmp’’āṅa ; loe.y -->
</lg>
                   <lg n="17" met="brahmagīti">
<l n="a">keta pāna prāṁmbila chnāṁ</l>
<l n="b">prājñā cāṁma hoey coeḥ chloeya</l><!-- kuch: hoe.y -->
<l n="c">Isa Aryya dharmma grupa hoeỵ</l><!-- kuch: hoe.y -->
<l n="d">traipīṭaka rattha matya de <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: mătya -->
</lg>
                   <lg n="18" met="brahmagīti">
<l n="a">Itth khussa chgoṅa tala tica</l>
<l n="b">thleṅa bāka bejña sreca Eṅa E</l>
<l n="c">doḥ chloey do niṅa gey</l><!-- kuch: chloe.y ; ge.y -->
<l n="d">toḥ prasnā qviy gra dāla sālya<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: qvi.y ; d˘āla -->
</lg>
                   <lg n="19" met="brahmagīti">
<l n="a">sūmma coeḥ capa trai<lb n="7"/>bheda</l>
<l n="b">soelasāsa seta qyita desa dāla</l><!-- kuch: sĕta -->
<l n="c">chuta chāppa jā Isacāryya</l><!-- kuch: chā˘ppa -->
<l n="d">tūca braḥ paramesūra nai<g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="20" met="brahmagīti">
<l n="a">sūma dana braḥ śri Āryya</l><!-- kuch: dăna -->
<l n="b">māna paribāra crena krāsa krai</l>
<l n="c">jā rraya bāna hmīṇa nai</l><!-- kuch: b˘āna ; hm.īṇa -->
<l n="d">lqa prabaiy toy prāthnā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: prabai.y ; to.y -->
</lg>
