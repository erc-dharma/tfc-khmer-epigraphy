   <text xml:space="preserve">
        <body>
                <div type="edition" xml:lang="xhm-Latn" rendition="class:83231 maturity:83213">
                   <lg n="1" met="brahmagīti">
<l n="a"><lb n="1"/>sabbhamasa suostī</l>
<l n="b">śrī sabva śrī maṅgalā</l>
<l n="c">bahula braḥ jaiyyā</l>
<l n="d">toy sārddhātirek Ai <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: to.y -->
</lg>
                   <lg n="2" met="brahmagīti">
<l n="a">nā 1623</l>
<l n="b">sak naeḥ I masaeña nai</l><!-- kuch: s’’ak  -->
<l n="c">dvāradasa roja māgha mai</l>
<l n="d">dibāra thṅai braḥhassatī <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="3" met="brahmagīti">
<l n="a">bi temma naeḥ Eṅ nā</l>
<l n="b">toy gāṭhā braḥ pāḷī</l><!-- kuch: to.y -->
<l n="c">loek sarasera buddhī</l>
<l n="d">pada muḥhni braṁhmagitta <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="4" met="brahmagīti">
<l n="a"><lb n="2"/>Añ khñuṁma thvāy pubhbhā</l><!-- kuch: thvā.y -->
<l n="b">braḥ bhaggavā sarbvejña</l>
<l n="c">sṭhita trāsa yala {2}</l>
<l n="d">staeca guṅa gita phcaña māra nai <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="5" met="brahmagīti">
<l n="a">paduṁma krabvaṁma sqāta</l>
<l n="b">thvāy braḥ pādda sarbvejña thlai</l><!-- kuch: thvā.y -->
<l n="c">luta loeka dassa kara krai</l>
<l n="d">phcaṅa prabai tāka sirasīy<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: sirasī.y -->
</lg>
                   <lg n="6" met="brahmagīti">
<l n="a">khñuṁma krāppa kromma braḥ pādda</l><!-- kuch: krā˘ppa -->
<l n="b">Abbhīvādavaravandī</l>
<l n="c">gita thvāy dau braḥ śrī</l><!-- kuch: thvā.y -->
<l n="d">ratna traiya śrīkkāllā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="7" met="brahmagīti">
<l n="a">ruṅa rīoeṅa pālaṁṅ<lb n="3"/>bejña</l><!-- kuch: pālaṁ.ṅ -->
<l n="b">bīycitra sreca riccanā</l><!-- kuch: bī.ycitra -->
<l n="c">chlāka chlov jā bhñī phkā</l>
<l n="d">parapūr puon dantappa hāta <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: h˘āta -->
</lg>
                   <lg n="8" met="brahmagīti">
<l n="a">tāmma thpūṅa syiṅa grupp bārṇna</l><!-- kuch: gru˘pp -->
<l n="b">lqa Iscāryya chluḥ cravāttha</l>
<l n="c">keta phsaṁ bodhisatva</l>
<l n="d">braḥ guṅa sṭhita jhnāḥ māra phoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="9" met="brahmagīti">
<l n="a">thvāy braḥ sākhyamnī</l><!-- kuch: thvā.y -->
<l n="b">no braḥ śrīĀra sota hoṅa</l>
<l n="c">trassa dharmma nāṁm satva phoṅa</l><!-- kuch: trăssa ; nāṁ.m -->
<l n="d">knuṅa ganlaṅa kālpa<lb n="4"/>naeḥ nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="10" met="brahmagīti">
<l n="a">khñuṁma krāp kromma braḥ pādda</l>
<l n="b">Abbhīvādavaravandā</l>
<l n="c">praṇaṁ braḥ sāstā</l>
<l n="d">pañcabuddhā ratna ta trai <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="11" met="brahmagīti">
<l n="a">tejaḥ Aña khñuṁ thvāy</l><!-- kuch: thvā.y -->
<l n="b">dasakara kāya Isa hradaiy</l><!-- kuch: hradai.y -->
<l n="c">phjaṁma phcaṅa gaṁmpaṅa thlai</l>
<l n="d">citra mūla maiy nai prāthnā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: mai.y -->
</lg>
                   <lg n="12" met="brahmagīti">
<l n="a">gīttha thvāỵ braḥ cettīỵ</l><!-- kuch: thvā.y, cettī.y -->
<l n="b">culāmnī traitriṅsa nā</l>
<l n="c">sāṅa duka braḥ kessā</l>
<l n="d">Is debvatā thvāy paṅgaṁmma <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: thvā.y -->
</lg>
                   <lg n="13" met="brahmagīti">
<l n="a">thvāỵ braḥ prattīmā</l>
<l n="b">mā<lb n="5"/>sa no nā sṭhāṇa Asraṁma</l>
<l n="c">braḥ traisarṇāgaṁ</l>
<l n="d">jā bvuṁnak nai satva phoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: bvuṁn’’ak -->
</lg>
                   <lg n="14" met="brahmagīti">
<l n="a">thvāy braḥ buddharuppa</l><!-- kuch: thvā.y -->
<l n="b">braḥ sadhūpa caittī hoṅa</l>
<l n="c">thvāỵ grupa braḥ jīỵ phoṅa</l><!-- kuch: thvā.y ; jī.y -->
<l n="d">braḥ sādha gaṅ braḥ gohā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: g’’aṅ -->
</lg>
                   <lg n="15" met="brahmagīti">
<l n="a">tejaḥ Aña khñuṁ thvāy</l><!-- kuch: thvā.y -->
<l n="b">spaṅakāca kāya kappa hātthā</l>
<l n="c">luta loeka Isa Aṅgā</l>
<l n="d">thvāỵ vandā sureca hoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: thvā.y -->
</lg>
                   <lg n="16" met="brahmagīti">
<l n="a">thvāy hey khñuṁ dūla phtiṅa</l><!-- kuch: thvā.y ; he.y -->
<l n="b">sūm Oy tyi<lb n="6"/>ṅa Isa Āra phoṅa</l><!-- kuch: O.y -->
<l n="c">jāttisarañāṇa hoṅa</l>
<l n="d">kuṁ kaṁmp’’āṅa bhlāṁṅa bhlecca loey <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: kaṁmp’’āṅa ; loe.y -->
</lg>
                   <lg n="17" met="brahmagīti">
<l n="a">keta pāna prāṁmbila chnāṁ</l>
<l n="b">prājñā cāṁma hoey coeḥ chloeya</l><!-- kuch: hoe.y -->
<l n="c">Isa Aryya dharmma grupa hoeỵ</l><!-- kuch: hoe.y -->
<l n="d">traipīṭaka rattha matya de <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: mătya -->
</lg>
                   <lg n="18" met="brahmagīti">
<l n="a">Itth khussa chgoṅa tala tica</l>
<l n="b">thleṅa bāka bejña sreca Eṅa E</l>
<l n="c">doḥ chloey do niṅa gey</l><!-- kuch: chloe.y ; ge.y -->
<l n="d">toḥ prasnā qviy gra dāla sālya<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: qvi.y ; d˘āla -->
</lg>
                   <lg n="19" met="brahmagīti">
<l n="a">sūmma coeḥ capa trai<lb n="7"/>bheda</l>
<l n="b">soelasāsa seta qyita desa dāla</l><!-- kuch: sĕta -->
<l n="c">chuta chāppa jā Isacāryya</l><!-- kuch: chā˘ppa -->
<l n="d">tūca braḥ paramesūra nai<g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="20" met="brahmagīti">
<l n="a">sūma dana braḥ śri Āryya</l><!-- kuch: dăna -->
<l n="b">māna paribāra crena krāsa krai</l>
<l n="c">jā rraya bāna hmīṇa nai</l><!-- kuch: b˘āna ; hm.īṇa -->
<l n="d">lqa prabaiy toy prāthnā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: prabai.y ; to.y -->
</lg>
                   <lg n="21" met="brahmagīti">
<l n="a">sebva jīnaśrī do puosa</l><!-- kuch: jīn’’aśrī -->
<l n="b">hloeṅa phala phnuossa lqa thlai thlā</l>
<l n="c">saṁnāk braḥ sāsnā</l><!-- kuch: saṁnā˘k -->
<l n="d">pān braḥ buddha duṁnāy dukkha<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: duṁnā.y -->
</lg>
                   <lg n="22" met="brahmagīti">
<l n="a">braḥ śrīĀryya dāy<lb n="8"/>thā</l><!-- kuch: dā.y -->
<l n="b">qnaka naeḥ nā trass E mukkha</l><!-- kuch: trăss -->
<l n="c">jā braḥ buddha svoỵ sukkha</l><!-- kuch: svo.y -->
<l n="d">trassa dharmma dukkha nāṁmma satva nai <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: trăssa -->
</lg>
                   <lg n="23" met="brahmagīti">
<l n="a">khñuṁ sūma noḥ roeṅa moka</l><!-- kuch: m’’oka -->
<l n="b">jā banlaka sarbvejña thlai</l>
<l n="c">Aṅga khñuṁ naeḥ Eṅa nai</l>
<l n="d">toy nāmmai hova jaiyananna<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: to.y ; jaiyan’’anna -->
</lg>
                   <lg n="24" met="brahmagīti">
<l n="a">rī nāṅ jā kansai</l>
<l n="b">jhmoḥ bira nai mīṅa paen sana</l><!-- kuch: m.īṅa ; s’’ana -->
<l n="c">rupa chomma dana Ena Ana</l>
<l n="d">yala smāka samma caritta śri <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="25" met="brahmagīti">
<l n="a">luḥ braḥ pād rājjā</l>
<l n="b">Oy saktā didaiy khmi</l><!-- kuch: O.y ; didai.y -->
<l n="c"><lb n="9"/>jaiyanana snādhibvatiy</l><!-- kuch: jaiyan’’ana ; snādhibvati.y -->
<l n="d">hoeỵ Oỵ chiỵ braiỵ kti hoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: hoe.y ; O.y ; chi.y ; brai.y -->
</lg>
                   <lg n="26" met="brahmagīti">
<l n="a">tala dau chiỵ thpūṅa ghmaṁma</l><!-- kuch: chi.y -->
<l n="b">hnāhmīna dhaṁ Eka Eṅa hoṅa</l><!-- kuch: hnāhm.īna -->
<l n="c">luḥ jā yammrāja phoṅa</l>
<l n="d">noḥ Eṅa hoṅa sāṅa trīsūra <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="27" met="brahmagīti">
<l n="a">E miṅa paena noḥ nā</l>
<l n="b">yasasakkhatā toy guṁnuora</l><!-- kuch: to.y -->
<l n="c">jhmoḥ yala parapūra</l>
<l n="d">jā juṁdāva debvasubarṇna <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="28" met="brahmagīti">
<l n="a">riy qnaka naeḥ daṁṅ byira</l><!-- kuch: ri.y ; daṁ.ṅ -->
<l n="b">toy ramila yala Isacaryya</l><!-- kuch: to.y -->
<l n="c">jāta naeḥ ¯l̥<lb n="10"/>duov dāra</l><!-- kuch: ¯l̥ -->
<l n="d">keta dukkha brāta jā dāyāta <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="29" met="brahmagīti">
<l n="a">jāta naeḥ bvuṁ parapūra</l>
<l n="b">prāsa bvuṁ mūla croena ghlā ghlāta</l>
<l n="c">doḥ koeta sabv2 jāta</l>
<l n="d">kuṁ trā ghlāta tala teca loeỵ <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: loe.y -->
</lg>
                   <lg n="30" met="brahmagīti">
<l n="a">vipāka naeḥ phoṅa gnā</l>
<l n="b">moka croena grā bvaṁ trā spoeỵ</l><!-- kuch: spoe.ỵ -->
<l n="c">Aṁmbi jāta naeḥ hoeỵ</l><!-- kuch: hoe.ỵ -->
<l n="d">khñuṁ vīera traṅa vipāka prānna <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="31" met="brahmagīti">
<l n="a">doḥ laeṅa jāta naeḥ dova</l>
<l n="b">vila moka nau koeta rvūma sṭhāṇna</l>
<l n="c">traṅa du<lb n="11" break="no"/>kkha Asrūva prāna</l>
<l n="d">kuṁ trā māna bhita bhairiỵ <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: bhairi.ỵ -->
</lg>
                   <lg n="32" met="brahmagīti">
<l n="a">kāla qyita niṅa braḥbandha</l>
<l n="b">soka lesa lana dana Indrī</l><!-- kuch: l’’ana ; d’’ana -->
<l n="c">hoeỵ ka braḥ cāyatiỵ</l><!-- kuch: k’’a ; cāyati.ỵ  -->
<l n="d">dukkha dhāta ni pī niṅa kūna <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                    <lg n="33" met="brahmagīti">
<l n="a">riỵ kūna daṁṅ byira Aṅga</l><!-- kuch: ri.ỵ ; daṁ.ṅ -->
<l n="b">Ābuka phcaṅa dhvoe punya jūna</l>
<l n="c">prakapa mtāya niṅa kūna</l><!-- kuch: prak’’apa -->
<l n="d">qnak Imma Ūṅa no mūỵ sṭhāṇa <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: mū.ỵ -->
</lg>
                   <lg n="34" met="brahmagīti">
<l n="a">hoeỵ sāṅa braḥ pāka paeka</l><!-- kuch: hoe.ỵ -->
<l n="b">pāka jañjaeka paeka Aṅga prāna</l>
<l n="c">khcāttha khcāya<lb n="12"/>Antaradhān</l>
<l n="d">pāka Isa prāna jāta kaṁnāta <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: kaṁn˘āta -->
</lg>
                   <lg n="35" met="brahmagīti">
<l n="a">E khlāḥ pāka sūraṅa</l><!-- kuch: sūr’’aṅa -->
<l n="b">braḥ kesa phoṅa dhlāka ciña pāta</l>
<l n="c">braḥ pādda jā kuṁnāta</l>
<l n="d">braḥ hasa pāta tāca khcāta khcāya <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: hăsa ; p˘āta ; t˘āca -->
</lg>
                   <lg n="36" met="brahmagīti">
<l n="a">khaṁ roka roessa pamūla</l>
<l n="b">poḥ pjāppa cūla mūla rrappa kāỵ</l><!-- kuch: kā.ỵ -->
<l n="c">poeta māssa Isa daṁṅ hlāỵ</l><!-- kuch: daṁ.ṅ ; hlā.ỵ -->
<l n="d">jā banrāyya lqa māna draṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="37" met="brahmagīti">
<l n="a">riỵ rāpa Isa daṁṅ hlāỵ</l><!-- kuch: r˘āpa ; daṁ.ṅ ; hlā.ỵ -->
<l n="b"><lb n="13"/>maruya plāya 30 braḥ Aṅga</l>
<l n="c">sāṅa braḥ pada bira phcaṅa</l>
<l n="d">gūra grupa Aṅga rupa tūca ddhaṁ <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="38" met="brahmagīti">
<l n="a">heỵ puosa chloṅa cāyatiỵ</l><!-- kuch: cāyati.ỵ -->
<l n="b">braḥ sāṅa thmi noḥ chloṅa phjuṁma</l>
<l n="c">chloṅa rvuoca daṁṅ tūca ddhaṁ</l><!-- kuch: daṁ.ṅ -->
<l n="d">jā Ūtaṁmma phnūsa sreca hoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="39" met="brahmagīti">
<l n="a">sratīỵ tae nū naeḥ</l><!-- kuch: sratī.ỵ -->
<l n="b">bvuṁ rīepa rīḥ biỵ toemma phoṅa</l><!-- kuch: bi.ỵ -->
<l n="c">dhvoeỵ punya noḥ croena hoṅa</l><!-- kuch: dhvoe.ỵ -->
<l n="d">puossa prāṁmma toṅa niṅa naeḥ nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="40" met="brahmagīti">
<l n="a">kāl puḥ braḥ mā<lb n="14" break="no"/>sa mūla</l>
<l n="b">sāṅa trīsūra noḥ mūỵ grā</l><!-- kuch: mū.y -->
<l n="c">siddha braḥ sīhiṅa nā</l><!-- kuch: n’’ā -->
<l n="d">puḥ braḥ māsa prāka croena phoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="41" met="brahmagīti">
<l n="a">dhvoe punya bi munna nā</l>
<l n="b">saṅa sālā vihāra hoṅa</l>
<l n="c">paṁmpuos kūna grupa phoṅa</l>
<l n="d">prosa khñuṁ hoṅa pañcuḥ sīmmā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="42" met="brahmagīti">
<l n="a">niṅa gita toỵ smādāna</l><!-- kuch: to.y -->
<l n="b">cāṁma bvuṁ pāna padda croena grā</l>
<l n="c">Oỵ dāna khlāḥ pān trā</l><!-- kuch: O.y -->
<l n="d">toỵ gannā gittha jā caṅỵ <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: to.y ; c’’aṅ.ỵ -->
</lg>
                   <lg n="43" met="brahmagīti">
<l n="a">sratiỵ toỵ cā kāta</l><!-- kuch: srati.y ; to.y -->
<l n="b"><lb n="15"/>bvuṁ rīepa rāpa bī tema phcaṅa</l><!-- kuch: r˘āpa -->
<l n="c">poe gita Oỵ dāna sagha</l><!-- kuch: O.y ; sa^gha -->
<l n="d">noḥ croena hnāsa cāṁmma bvuṁ pāna <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: hn˘āsa -->
</lg>
                   <lg n="44" met="brahmagīti">
<l n="a">toỵ gita dhvoe punya nā</l><!-- kuch: to.y -->
<l n="b">niṅa gannā croenna sabva sṭhāna</l>
<l n="c">niṅa cāṁma noḥ bvuṁ pāna</l>
<l n="d">padda toỵ sṭhāna croena taṅa nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: to.y ; t’’aṅa -->
</lg>
                   <lg n="45" met="brahmagīti">
<l n="a">sūta biỵ naeḥ do heỵ</l><!-- kuch: bi.y ; he.y -->
<l n="b">sūta paṅaheỵ cuḥ dova lpā</l><!-- kuch: paṅahe.ỵ -->
<l n="c">sūta rvuoca Isa naeḥ nā</l>
<l n="d">sūta simmanūma saṁmreca hoṅa <g ref="sym:floret" type="punctuation">.</g><g ref="sym:gomutra" type="punctuation">.</g></l>
</lg>
   <lg n="46" met="bhujaṅgalīlā">
<l n="a"><lb n="16"/>naeḥ pada būjuṅ lelā</l>
<l n="b">loeka toỵ kābyā</l><!-- kuch: to.y -->
<l n="c">jā lpā daṁṅ hlāỵ<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: daṁ.ṅ ; hlā.ỵ -->
</lg>
                   <lg n="47" met="bhujaṅgalīlā">
<l n="a">lā Isa lobha dossaṁmuddāya</l>
<l n="b">lā bhaiỵ Antarāya</l><!-- kuch: bhai.ỵ -->
<l n="c">brāta brāya prāsa gnā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="48" met="bhujaṅgalīlā">
<l n="a">khñuṁ krāppa dūla braḥ buddhā</l>
<l n="b">braḥ heỵ khñuṁ lā</l><!-- kuch: he.y -->
<l n="c">traṅa nā duka soka <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="49" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa kuṁṇoetra thoka</l>
<l n="b">ketra moka Isa loka</l>
<l n="c">soeca tīela santāna<g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="50" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā sabva jā<lb n="17"/>ta vyera sṭhāna</l>
<l n="b">kti Āsrūva prāna</l>
<l n="c">kuṁ mān loeỵ nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: loe.y -->
</lg>
                   <lg n="51" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa Ita prājñā</l>
<l n="b">chṅala khlova mohā</l>
<l n="c">khmāsa ge Īena prīena<g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="52" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa Ita rapīena</l>
<l n="b">cūla jaṁnuṁ sṅīema</l>
<l n="c">bvuṁ coeḥ chloeỵ thā<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: chloe.ỵ -->
</lg>
                   <lg n="53" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā bisa bhyādha roggā</l>
<l n="b">prāsa putra bhiryyā</l>
<l n="c">slāpa Opāsa prana <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: slā˘pa -->
</lg>
                   <lg n="54" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā bipāka pūrāna</l><!-- kuch: pūrā˘na -->
<l n="b">jā duka knuṅa prāna</l>
<l n="c">srika<lb n="18"/>ghlāna noḥ phoṅa <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="55" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā Isa pā˘pa bīera hoṅa</l><!-- kuch: pā˘pa -->
<l n="b">citturāpāỵ phoṅa</l><!-- kuch: citturāpā.ỵ -->
<l n="c">puona kuṁ dau svoỵ <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: svo.ỵ -->
</lg>
                   <lg n="56" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa guṁnita dhloya</l>
<l n="b">lā khjila kuṁsvoỵ</l><!-- kuch: kuṁsvo.ỵ -->
<l n="c">heỵ smārtiỵ toeca<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: he.y ; smārti.ỵ -->
</lg>
                   <lg n="57" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā bvuṁ coeḥ kala kica</l>
<l n="b">soelyasāsya kāra srecca</l>
<l n="c">bāka bejña noḥ nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="58" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa Ita prājñā</l>
<l n="b">bvuṁ coeḥ bhāsā</l>
<l n="c">sratiỵ niṅa<lb n="19"/>geỵ<g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: srati.ỵ ; ge.y -->
</lg>
                   <lg n="59" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa khsata khluona de</l>
<l n="b">tramoca Eṅa E</l>
<l n="c">Ita prīeṅa nū bhṅā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="60" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā Ita drābva bhoggatā</l>
<l n="b">dāssidāssā</l>
<l n="c">bvuṁ māna tala mnaka <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="61" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa citra prattiyāka</l><!-- kuch: prattiy˘āka -->
<l n="b">sratti Oỵ Āka</l><!-- kuch: O.y -->
<l n="c">Ana Īena citra geỵ <g ref="sym:bullet-hollow" type="punctuation">.</g></l><!-- kuch: ge.y -->
</lg>
                   <lg n="62" met="bhujaṅgalīlā">
<l n="a">khñuṁ lā traṅa bāka srāla sre</l>
<l n="b">sratiỵ tūca geỵ</l><!-- kuch: srati.y ; ge.y -->
<l n="c">mamoeha chkuota nā <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
                   <lg n="63" met="bhujaṅgalīlā">
<l n="a">khñuṁ<lb n="20"/>lā traṅa chota bhāsā</l>
<l n="b">sratiỵ dau thā</l><!-- kuch: srati.ỵ -->
<l n="c">babhlīeha Ita kāryya <g ref="sym:bullet-hollow" type="punctuation">.</g></l>
</lg>
