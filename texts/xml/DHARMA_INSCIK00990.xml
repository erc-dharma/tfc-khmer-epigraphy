        <body>
                <div type="edition" rendition="class:83231 maturity:83213">
<div type="textpart" n="A" xml:lang="san-Latn"><head xml:lang="eng">Face A</head>
                   <p>
   <lb n="A1"/>… ye pālaye…
                      <lb n="A2"/>… ntv aikāgārikani…
                      <lb n="A3"/>… pe niveda…
                      <lb n="A4"/>… vasantu hare…
                      <lb n="A5"/>… mantryādibhi…
                      <lb n="A6"/>… lyo yam āśra…
                      <lb n="A7"/>… cailādhipatyādai…
                      <lb n="A8"/>… tādhikāribhiḥ <g ref="sym:circle-bullseye" type="punctuation">.</g> m…
                      <lb n="A9"/>… saṁhārā{1}rVCī…
</p>
                   </div>
                   <div type="textpart" n="B" xml:lang="okz-Latn"><head xml:lang="eng">Face B</head>
                   <p>
   <lb n="B1"/>… śaka pi ket…
                      <lb n="B2"/>… vraḥ śāsana [dhūli vraḥ pāda]
                      <lb n="B3"/>[dhūli] jeṅ vraḥ kaṁ[mrateṅ Añ]
                      <lb n="B4"/>[śrīja]yavarmmadeva…
                      <lb n="B5"/>… nu kaṁsteṅ…
                      <lb n="B6"/>… pre pandval…
                      <lb n="B7"/>… śrīnātha…
                      <lb n="B8"/>… sthāpanā neḥ praśa[sta]…
                      <lb n="B9"/>… kr̥tajñanagara <g ref="sym:bullet-hollow" type="punctuation">.</g> nau…
</p>
                   </div>
</div>
