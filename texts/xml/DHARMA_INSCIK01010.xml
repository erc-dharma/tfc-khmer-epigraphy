<p>
   <lb n="1"/>Aṁnoy· poñ· mādhavagoṣa
   <lb n="2"/>Āy· ta vraḥ kamratāṅ· Añ·
   <lb n="3"/>śrīvaddhapramocanasvāmi <g ref="sym:bar" type="punctuation">.</g> kantai
   <lb n="4"/><gap reason="lost" quantity="1" unit="character"/> <supplied reason="lost">ya</supplied>jamāna Āy· ta vraḥ klo<lb n="5" break="no"/><supplied reason="lost">ñ·</supplied> <gap reason="lost" quantity="2" unit="character"/> k<supplied reason="lost">ñu</supplied>ṁ ta kantai ku <unclear>k</unclear><seg type="component" subtype="vowel"><gap reason="illegible" quantity="1" unit="component"/></seg><seg type="component" subtype="body"><gap reason="illegible" quantity="1" unit="component"/></seg>·
</p>
