<p>
   <lb n="1"/>mūla gui kñuṁ vraḥ kamratāṅ· Añ· śrī vr̥ṣabhadhvajeśvara <gap reason="lost" quantity="2" unit="character"/> ku
   <lb n="2"/>vraḥ kañje <num value="1"><g type="numeral">I</g></num> kon<unclear>·</unclear> <num value="2"><g type="numeral">II</g></num> <gap reason="lost" quantity="2" unit="character"/> <num value="1"><g type="numeral">I</g></num> kon<unclear>·</unclear> <num value="3"><g type="numeral">III</g></num> ku mandodarī <num value="1"><g type="numeral">I</g></num> kon· <num value="1"><g type="numeral">I</g></num> ku ratnaśrīya <num value="1"><g type="numeral">I</g></num> ku ma<lb n="3" break="no"/>llavikā <num value="1"><g type="numeral">I</g></num> ku sanidha <num value="1"><g type="numeral">I</g></num> ku n<seg type="component" subtype="vowel"><gap reason="lost" quantity="1" unit="component"/></seg>śrīya <num value="1"><g type="numeral">I</g></num> ku Agat· <num value="1"><g type="numeral">I</g></num> ku juṅ· <num value="1"><g type="numeral">I</g></num> ku kañjoṅ· <num value="1"><g type="numeral">I</g></num> ku tvās· <num value="1"><g type="numeral">I</g></num>
